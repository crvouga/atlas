{
  "name": "@crvouga/atlas",
  "version": "0.0.0-development",
  "description": "Atlas: specs of any kind, reported as layered evidence. Publish checks from any runner (JUnit, CTRF, a script), combine them across nodes, branches, environments and backends, gate CI on the result, and run statecharts against the real app.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./packages/visualizer/**",
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crvouga/atlas.git"
  },
  "homepage": "https://github.com/crvouga/atlas#readme",
  "bugs": {
    "url": "https://github.com/crvouga/atlas/issues"
  },
  "keywords": [
    "test-reports",
    "ctrf",
    "junit",
    "gherkin",
    "specifications",
    "statecharts",
    "scxml",
    "xstate",
    "model-based-testing",
    "e2e",
    "playwright",
    "webdriver",
    "visualizer"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.2.0"
  },
  "bin": {
    "atlas": "./packages/core/bin/atlas.mjs",
    "atlas-visualizer": "./packages/visualizer/bin/atlas-visualizer.mjs"
  },
  "exports": {
    ".": "./packages/core/src/index.ts",
    "./spec": "./packages/core/src/spec/index.ts",
    "./signals": "./packages/core/src/signals.ts",
    "./cli": "./packages/core/src/cli.ts",
    "./playwright": "./packages/playwright/src/index.ts",
    "./bun": "./packages/bun/src/index.ts",
    "./webdriver": "./packages/webdriver/src/index.ts",
    "./detox": "./packages/detox/src/index.ts",
    "./vitest": "./packages/vitest/src/index.ts",
    "./schema": "./packages/schema/src/index.ts",
    "./server": "./packages/server/src/index.ts",
    "./critics": "./packages/critics/src/index.ts",
    "./reports/*": "./packages/reports/src/*.ts",
    "./schemas/*": "./packages/schema/schemas/*",
    "./openapi.json": "./packages/server/openapi.json",
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt",
    "./mocha": {
      "require": "./packages/runners/compat/mocha.cjs",
      "default": "./packages/runners/src/mocha.ts"
    },
    "./codecept": {
      "require": "./packages/runners/compat/codecept.cjs",
      "default": "./packages/runners/src/codecept.ts"
    },
    "./jest": {
      "require": "./packages/runners/compat/jest.cjs",
      "default": "./packages/runners/src/jest.ts"
    },
    "./node-test": "./packages/runners/src/node-test.ts",
    "./playwright-reporter": "./packages/playwright-reporter/src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/core/src/index.d.ts",
        "default": "./dist/core/src/index.js"
      },
      "./spec": {
        "types": "./dist/core/src/spec/index.d.ts",
        "default": "./dist/core/src/spec/index.js"
      },
      "./signals": {
        "types": "./dist/core/src/signals.d.ts",
        "default": "./dist/core/src/signals.js"
      },
      "./cli": {
        "types": "./dist/core/src/cli.d.ts",
        "default": "./dist/core/src/cli.js"
      },
      "./playwright": {
        "types": "./dist/playwright/src/index.d.ts",
        "default": "./dist/playwright/src/index.js"
      },
      "./bun": {
        "types": "./dist/bun/src/index.d.ts",
        "default": "./dist/bun/src/index.js"
      },
      "./webdriver": {
        "types": "./dist/webdriver/src/index.d.ts",
        "default": "./dist/webdriver/src/index.js"
      },
      "./detox": {
        "types": "./dist/detox/src/index.d.ts",
        "default": "./dist/detox/src/index.js"
      },
      "./vitest": {
        "types": "./dist/vitest/src/index.d.ts",
        "default": "./dist/vitest/src/index.js"
      },
      "./schema": {
        "types": "./dist/schema/src/index.d.ts",
        "default": "./dist/schema/src/index.js"
      },
      "./server": {
        "types": "./dist/server/src/index.d.ts",
        "default": "./dist/server/src/index.js"
      },
      "./critics": {
        "types": "./dist/critics/src/index.d.ts",
        "default": "./dist/critics/src/index.js"
      },
      "./reports/*": {
        "types": "./dist/reports/src/*.d.ts",
        "default": "./dist/reports/src/*.js"
      },
      "./schemas/*": "./packages/schema/schemas/*",
      "./openapi.json": "./packages/server/openapi.json",
      "./llms.txt": "./llms.txt",
      "./llms-full.txt": "./llms-full.txt",
      "./mocha": {
        "types": "./dist/runners/src/mocha.d.ts",
        "require": "./packages/runners/compat/mocha.cjs",
        "default": "./dist/runners/src/mocha.js"
      },
      "./codecept": {
        "types": "./dist/runners/src/codecept.d.ts",
        "require": "./packages/runners/compat/codecept.cjs",
        "default": "./dist/runners/src/codecept.js"
      },
      "./jest": {
        "types": "./dist/runners/src/jest.d.ts",
        "require": "./packages/runners/compat/jest.cjs",
        "default": "./dist/runners/src/jest.js"
      },
      "./node-test": {
        "types": "./dist/runners/src/node-test.d.ts",
        "default": "./dist/runners/src/node-test.js"
      },
      "./playwright-reporter": {
        "types": "./dist/playwright-reporter/src/index.d.ts",
        "default": "./dist/playwright-reporter/src/index.js"
      }
    }
  },
  "files": [
    "dist",
    "packages/core/bin",
    "packages/schema/schemas",
    "packages/server/openapi.json",
    "llms.txt",
    "llms-full.txt",
    "docs/agents.md",
    "docs/quickstart.md",
    "docs/reference",
    "packages/visualizer/bin",
    "packages/visualizer/example",
    "packages/visualizer/fixtures",
    "packages/visualizer/index.html",
    "packages/visualizer/scripts",
    "packages/visualizer/src",
    "packages/visualizer/vite",
    "packages/visualizer/vite.config.ts",
    "packages/*/README.md",
    "packages/reports/STORAGE.md",
    "docs/integrating.md",
    "docs/deploying.md",
    "docs/server.md",
    "docs/extending.md",
    "docs/rich-evidence.md",
    "docs/statecharts.md",
    "docs/report-contract.md",
    "docs/report-backends.md",
    "docs/dogfooding.md",
    "docs/reporting-issues.md",
    "CHANGELOG.md",
    "docs/runners.md",
    "packages/runners/compat",
    "docs/ui.md",
    "docs/workspaces.md",
    "docs/critics.md"
  ],
  "scripts": {
    "build": "bun scripts/build-package.ts",
    "test": "bun test && bun test --cwd packages/visualizer --preload ./tests/preload.ts tests",
    "type-check": "for dir in packages/* scripts scripts/docs examples/todo; do tsc --noEmit -p \"$dir\" || exit 1; done",
    "schemas": "bun packages/schema/scripts/emit-json-schemas.ts",
    "docs": "bun scripts/docs/generate.ts",
    "docs:check": "bun test scripts/docs scripts/release/docs-links.test.ts packages/schema/tests/schemas.test.ts packages/server/tests/openapi.test.ts packages/server/tests/settings.test.ts",
    "dev": "bun packages/core/bin/atlas.mjs dev",
    "client:dev": "bun packages/core/bin/atlas.mjs dev",
    "client:build": "bun packages/core/bin/atlas.mjs client build --no-data",
    "client:publish-data": "bun packages/visualizer/scripts/publish-data.ts",
    "client:fixtures": "bun packages/visualizer/scripts/make-fixtures.ts",
    "example:start": "bun examples/todo/server.ts",
    "example:lint": "bun --cwd examples/todo ../../packages/core/bin/atlas.mjs lint --require-implementations",
    "example:plan": "bun --cwd examples/todo ../../packages/core/bin/atlas.mjs plan",
    "example:fast": "bun --cwd examples/todo ../../packages/core/bin/atlas.mjs run --mode fast",
    "example:run": "bun examples/todo/run-all.ts",
    "example:clients": "bun --cwd examples/todo ../../packages/core/bin/atlas.mjs run --config clients/atlas.config.ts --mode showcase",
    "example:clients:bun": "ATLAS_DESKTOP=bun bun --cwd examples/todo ../../packages/core/bin/atlas.mjs run --config clients/atlas.config.ts --mode showcase",
    "atlas:run": "status=0; bun run example:clients || status=$?; bun run example:run || status=$?; exit $status",
    "release:plan": "bun scripts/release/plan.ts",
    "release:publish": "bun scripts/release/publish.ts",
    "release:smoke": "bun scripts/release/consumer-smoke.ts",
    "release:seed": "bun scripts/release/seed.ts",
    "health": "bun scripts/health/cli.ts",
    "prepare": "husky",
    "example:publish": "bun examples/todo/publish.ts",
    "atlas": "bun scripts/atlas.mjs",
    "workspace:setup": "bun scripts/workspace.ts setup",
    "workspace:run": "bun scripts/workspace.ts run",
    "workspace:preview": "bun scripts/workspace.ts preview",
    "workspace:status": "bun scripts/workspace.ts status",
    "workspace:stop": "bun scripts/workspace.ts stop",
    "workspace:check": "bun run docs:check && bun run type-check && bun run test && bun run build && bun run client:build --out .atlas-workspace/site && bun run release:smoke"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@mantine/code-highlight": "9.7.3",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/spotlight": "9.7.3",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/query-persist-client-core": "^5.104.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/solid-query": "^5.104.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "^12.11.5",
    "elkjs": "0.12.0",
    "fast-xml-parser": "5.11.0",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.5.0",
    "solid-js": "^1.9.15",
    "tsx": "4.23.13",
    "vite": "7.3.7",
    "xstate": "5.33.2",
    "yaml": "^2.9.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "detox": ">=20",
    "playwright": ">=1.45"
  },
  "peerDependenciesMeta": {
    "detox": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@informalsystems/quint": "^0.33.0",
    "@types/bun": "1.4.3",
    "@types/node": "^22.20.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.11.1",
    "husky": "^9.1.7",
    "playwright": "1.60.0",
    "typescript": "^5.9.3"
  }
}
