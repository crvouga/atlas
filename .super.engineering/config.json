{
  "setup": [
    "bun run dev --setup"
  ],
  "run": [
    {
      "name": "Dev",
      "commands": [
        "bun run dev"
      ],
      "stop_commands": [
        "bun run dev --stop server"
      ],
      "default": true
    },
    {
      "name": "Check",
      "commands": [
        "bun run check"
      ],
      "default": false
    },
    {
      "name": "Test",
      "commands": [
        "bun run test"
      ],
      "default": false
    },
    {
      "name": "Build",
      "commands": [
        "bun run build"
      ],
      "default": false
    },
    {
      "name": "Smoke",
      "commands": [
        "bun run smoke"
      ],
      "default": false
    },
    {
      "name": "Docs",
      "commands": [
        "bun run docs --check"
      ],
      "default": false
    }
  ],
  "teardown": [
    "bun run dev --stop"
  ],
  "commands": []
}
