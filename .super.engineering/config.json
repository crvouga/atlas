{
  "setup": [
    "bun run workspace:setup"
  ],
  "run": [
    {
      "name": "Atlas",
      "commands": [
        "bun run workspace:run"
      ],
      "stop_commands": [
        "bun run workspace:stop server"
      ],
      "default": true
    },
    {
      "name": "Viewer examples",
      "commands": [
        "bun run workspace:preview"
      ],
      "stop_commands": [
        "bun run workspace:stop preview"
      ],
      "default": false
    },
    {
      "name": "Checks",
      "commands": [
        "bun run workspace:check"
      ],
      "default": false
    }
  ],
  "teardown": [
    "bun run workspace:stop"
  ],
  "commands": [
    {
      "id": "b583ae6e-e6c9-44d7-aaf6-a7bbb449f396",
      "name": "Atlas URLs",
      "command": "bun run workspace:status",
      "dispatch_mode": "inject_current_chat",
      "view_preference": "default",
      "provider_preset_key": "none",
      "auto_submit": true
    },
    {
      "id": "10ad89c7-e31e-4122-854f-c3b59a611214",
      "name": "Check Atlas",
      "command": "bun run workspace:check",
      "dispatch_mode": "inject_current_chat",
      "view_preference": "default",
      "provider_preset_key": "none",
      "auto_submit": true
    },
    {
      "id": "ef60384e-457c-4876-8536-8287945f9bf1",
      "name": "Review Atlas UI",
      "command": "Read AGENTS.md and docs/ui.md. Run bun run workspace:status to discover the current worktree URLs. Review changed screens in the IDE browser at desktop and narrow widths, preserve report semantics, and run the relevant UI checks. Report evidence and limitations accurately.",
      "dispatch_mode": "inject_current_chat",
      "view_preference": "default",
      "auto_submit": true
    }
  ]
}
