{
  "$comment": "T3 Code project settings for Atlas. T3 keeps project scripts in its own settings, not in the repository, so it does not read this file by itself: ask an agent in a T3 thread to apply it (see docs/workspaces.md#t3-code). Every command calls the shared bun run dev lifecycle, so this works on any machine with the pinned Bun.",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    { "id": "atlas-setup", "name": "Setup", "command": "bun run dev --setup", "icon": "configure", "runOnWorktreeCreate": true, "async": false },
    { "id": "atlas-doctor", "name": "Doctor (machine readiness)", "command": "bun run dev --doctor", "icon": "debug", "runOnWorktreeCreate": false },
    { "id": "atlas-dev", "name": "Dev", "command": "bun run dev", "icon": "play", "runOnWorktreeCreate": false },
    { "id": "atlas-share", "name": "Dev + share on tailnet", "command": "bun run dev --share", "icon": "play", "runOnWorktreeCreate": false },
    { "id": "atlas-server", "name": "Server only (no examples)", "command": "bun run dev --server", "icon": "play", "runOnWorktreeCreate": false },
    { "id": "atlas-preview", "name": "Preview (bundled examples)", "command": "bun run dev --preview", "icon": "play", "runOnWorktreeCreate": false },
    { "id": "atlas-status", "name": "Status (local and shared URLs)", "command": "bun run dev --status", "icon": "debug", "runOnWorktreeCreate": false },
    { "id": "atlas-unshare", "name": "Stop sharing on tailnet", "command": "bun run dev --unshare", "icon": "debug", "runOnWorktreeCreate": false },
    { "id": "atlas-stop", "name": "Stop", "command": "bun run dev --stop", "icon": "debug", "runOnWorktreeCreate": false, "runOnSettle": true },
    { "id": "atlas-check", "name": "Check (everything CI runs)", "command": "bun run check", "icon": "test", "runOnWorktreeCreate": false },
    { "id": "atlas-test", "name": "Test", "command": "bun run test", "icon": "test", "runOnWorktreeCreate": false },
    { "id": "atlas-types", "name": "Types", "command": "bun run check --only types", "icon": "lint", "runOnWorktreeCreate": false },
    { "id": "atlas-lifecycle-tests", "name": "Workspace lifecycle tests", "command": "bun test scripts/workspace.test.ts scripts/workspace-share.test.ts", "icon": "test", "runOnWorktreeCreate": false },
    { "id": "atlas-ui-architecture", "name": "UI architecture test", "command": "bun test scripts/ui-architecture.test.ts", "icon": "test", "runOnWorktreeCreate": false },
    { "id": "atlas-docs", "name": "Regenerate docs", "command": "bun run docs", "icon": "build", "runOnWorktreeCreate": false },
    { "id": "atlas-docs-check", "name": "Docs check", "command": "bun run docs --check", "icon": "lint", "runOnWorktreeCreate": false },
    { "id": "atlas-build", "name": "Build", "command": "bun run build", "icon": "build", "runOnWorktreeCreate": false },
    { "id": "atlas-smoke", "name": "Smoke (packed package)", "command": "bun run smoke", "icon": "test", "runOnWorktreeCreate": false },
    { "id": "atlas-bench-catalog", "name": "Benchmark UI catalog", "command": "bun packages/server/bench/ui-catalog-bench.ts 5000 10", "icon": "debug", "runOnWorktreeCreate": false },
    { "id": "atlas-bench-server", "name": "Benchmark server", "command": "ATLAS_BENCH_DIR=/tmp/atlas-bench bun packages/server/bench/bench.ts 2000 100", "icon": "debug", "runOnWorktreeCreate": false }
  ]
}
