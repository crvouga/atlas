        <atlas:source>src/screens/told-the-payment-receipt-was-approved.tsx</atlas:source>
      </atlas:meta>
      <transition event="finishes-the-payment" target="payment-completed" atlas:name="Finishes the payment"/>
    </state>
  </state>
  <final id="payment-completed" atlas:name="Payment completed" atlas:done-event="Payment is completed">
    <atlas:meta>
      <atlas:description>The payment is done.</atlas:description>
      <atlas:snapshot>payment-completed</atlas:snapshot>
      <atlas:event>Payment completed</atlas:event>
      <atlas:confidence>confirmed</atlas:confidence>
      <atlas:source>src/screens/payment-completed.tsx</atlas:source>
    </atlas:meta>
  </final>
  <final id="payment-abandoned" atlas:name="Payment abandoned" atlas:done-event="Payment is abandoned">
    <atlas:meta>
      <atlas:description>The user left the payment before the end.</atlas:description>
      <atlas:snapshot>payment-abandoned</atlas:snapshot>
      <atlas:confidence>confirmed</atlas:confidence>
      <atlas:source>src/screens/payment-abandoned.tsx</atlas:source>
    </atlas:meta>
  </final>
</scxml>
