<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:atlas="https://github.com/crvouga/atlas/ns/1" version="1.0" name="Refund handling" datamodel="null" initial="handling-the-refund-request">
  <atlas:meta>
    <atlas:description>The refund handling, a step inside invoices and payments.</atlas:description>
    <atlas:snapshot>refund-handling</atlas:snapshot>
    <atlas:confidence>confirmed</atlas:confidence>
  </atlas:meta>
  <state id="handling-the-refund-request" atlas:name="Handling the refund request" initial="reviewing-the-refund-request">
    <atlas:meta>
      <atlas:description>Everything about the refund request, from review to approval.</atlas:description>
      <atlas:snapshot>handling-the-refund-request</atlas:snapshot>
      <atlas:confidence>confirmed</atlas:confidence>
      <atlas:source>src/screens/handling-the-refund-request.tsx</atlas:source>
      <atlas:owner>Billing team</atlas:owner>
    </atlas:meta>
    <state id="reviewing-the-refund-request" atlas:name="Reviewing the refund request">
      <atlas:meta>
        <atlas:description>The user checks the refund request before sending it.</atlas:description>
        <atlas:snapshot>reviewing-the-refund-request</atlas:snapshot>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/reviewing-the-refund-request.tsx</atlas:source>
        <atlas:gherkin>[&quot;features/billing/invoices/refund-request.feature&quot;]</atlas:gherkin>
      </atlas:meta>
      <transition event="taps-edit-on-the-refund-request" target="editing-the-refund-request" atlas:name="Taps edit on the refund request"/>
      <transition event="submits-the-refund-request" target="waiting-for-the-refund-request-to-be-approved" atlas:name="Submits the refund request"/>
      <transition event="closes-the-refund-handling" target="refund-handling-abandoned" atlas:name="Closes the refund handling"/>
    </state>
    <state id="editing-the-refund-request" atlas:name="Editing the refund request" initial="editing-the-refund-request-details">
      <atlas:meta>
        <atlas:description>The user changes the refund request, with an optional file.</atlas:description>
        <atlas:snapshot>editing-the-refund-request</atlas:snapshot>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/editing-the-refund-request.tsx</atlas:source>
      </atlas:meta>
      <transition event="saves-the-refund-request" target="reviewing-the-refund-request" atlas:name="Saves the refund request"/>
      <transition event="cancels-the-changes-to-the-refund-request" target="reviewing-the-refund-request" atlas:name="Cancels the changes to the refund request"/>
      <transition event="saving-the-refund-request-fails" target="told-the-refund-request-could-not-be-saved" atlas:name="Saving the refund request fails"/>
      <state id="editing-the-refund-request-details" atlas:name="Editing the refund request details">
        <atlas:meta>
          <atlas:description>A form with the refund request fields.</atlas:description>
          <atlas:snapshot>editing-the-refund-request-details</atlas:snapshot>
          <atlas:confidence>confirmed</atlas:confidence>
          <atlas:source>src/screens/editing-the-refund-request-details.tsx</atlas:source>
          <atlas:hints>[&quot;A text field per detail&quot;,&quot;An \&quot;Upload a file\&quot; link&quot;]</atlas:hints>
        </atlas:meta>
        <transition event="uploads-a-file" target="uploading-a-file-for-the-refund-request" atlas:name="Uploads a file"/>
      </state>
      <state id="uploading-a-file-for-the-refund-request" atlas:name="Uploading a file for the refund request">
        <atlas:meta>
          <atlas:description>A file picker for a document about the refund request.</atlas:description>
          <atlas:snapshot>uploading-a-file-for-the-refund-request</atlas:snapshot>
          <atlas:confidence>confirmed</atlas:confidence>
          <atlas:source>src/screens/uploading-a-file-for-the-refund-request.tsx</atlas:source>
        </atlas:meta>
        <transition event="finishes-uploading-the-file" target="editing-the-refund-request-details" atlas:name="Finishes uploading the file"/>
      </state>
    </state>
    <state id="told-the-refund-request-could-not-be-saved" atlas:name="Told the refund request could not be saved">
      <atlas:meta>
        <atlas:description>A message says the refund request could not be saved, with &quot;Try again&quot;.</atlas:description>
        <atlas:snapshot>told-the-refund-request-could-not-be-saved</atlas:snapshot>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/told-the-refund-request-could-not-be-saved.tsx</atlas:source>
      </atlas:meta>
      <transition event="tries-saving-the-refund-request-again" target="editing-the-refund-request" atlas:name="Tries saving the refund request again"/>
    </state>
    <state id="waiting-for-the-refund-request-to-be-approved" atlas:name="Waiting for the refund request to be approved">
      <atlas:meta>
        <atlas:description>A card says the refund request is being checked.</atlas:description>
        <atlas:snapshot>waiting-for-the-refund-request-to-be-approved</atlas:snapshot>
        <atlas:event>Refund request submitted</atlas:event>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/waiting-for-the-refund-request-to-be-approved.tsx</atlas:source>
        <atlas:tier>critical</atlas:tier>
      </atlas:meta>
      <transition event="billing-service-approves-the-refund-request" target="told-the-refund-request-was-approved" atlas:name="Billing service approves the refund request"/>
      <transition event="billing-service-rejects-the-refund-request" target="told-the-refund-request-was-rejected" atlas:name="Billing service rejects the refund request"/>
      <transition event="approval-of-the-refund-request-takes-longer-than-a-day" target="told-the-refund-request-is-still-under-review" atlas:name="Approval of the refund request takes longer than a day"/>
    </state>
    <state id="told-the-refund-request-is-still-under-review" atlas:name="Told the refund request is still under review">
      <atlas:meta>
        <atlas:description>A card says the refund request is still being checked.</atlas:description>
        <atlas:snapshot>told-the-refund-request-is-still-under-review</atlas:snapshot>
        <atlas:confidence>assumed</atlas:confidence>
        <atlas:source>src/screens/told-the-refund-request-is-still-under-review.tsx</atlas:source>
      </atlas:meta>
      <transition event="checks-the-refund-request-again" target="waiting-for-the-refund-request-to-be-approved" atlas:name="Checks the refund request again"/>
    </state>
    <state id="told-the-refund-request-was-rejected" atlas:name="Told the refund request was rejected">
      <atlas:meta>
        <atlas:description>A message explains why the refund request was not accepted.</atlas:description>
        <atlas:snapshot>told-the-refund-request-was-rejected</atlas:snapshot>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/told-the-refund-request-was-rejected.tsx</atlas:source>
      </atlas:meta>
      <transition event="starts-the-refund-request-again" target="reviewing-the-refund-request" atlas:name="Starts the refund request again"/>
    </state>
    <state id="told-the-refund-request-was-approved" atlas:name="Told the refund request was approved">
      <atlas:meta>
        <atlas:description>A message confirms the refund request is approved.</atlas:description>
        <atlas:snapshot>told-the-refund-request-was-approved</atlas:snapshot>
        <atlas:event>Refund request approved</atlas:event>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/told-the-refund-request-was-approved.tsx</atlas:source>
      </atlas:meta>
      <transition event="continues-to-the-refund-approval" target="handling-the-refund-approval" atlas:name="Continues to the refund approval"/>
    </state>
  </state>
  <state id="handling-the-refund-approval" atlas:name="Handling the refund approval" initial="reviewing-the-refund-approval">
    <atlas:meta>
      <atlas:description>Everything about the refund approval, from review to approval.</atlas:description>
      <atlas:snapshot>handling-the-refund-approval</atlas:snapshot>
      <atlas:confidence>confirmed</atlas:confidence>
