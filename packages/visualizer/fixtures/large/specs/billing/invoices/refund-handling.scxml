      <atlas:meta>
        <atlas:description>A card says the refund transfer is being checked.</atlas:description>
        <atlas:snapshot>waiting-for-the-refund-transfer-to-be-approved</atlas:snapshot>
        <atlas:event>Refund transfer submitted</atlas:event>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/waiting-for-the-refund-transfer-to-be-approved.tsx</atlas:source>
        <atlas:tier>critical</atlas:tier>
      </atlas:meta>
      <transition event="billing-service-approves-the-refund-transfer" target="told-the-refund-transfer-was-approved" atlas:name="Billing service approves the refund transfer"/>
      <transition event="billing-service-rejects-the-refund-transfer" target="told-the-refund-transfer-was-rejected" atlas:name="Billing service rejects the refund transfer"/>
      <transition event="approval-of-the-refund-transfer-takes-longer-than-a-day" target="told-the-refund-transfer-is-still-under-review" atlas:name="Approval of the refund transfer takes longer than a day"/>
    </state>
    <state id="told-the-refund-transfer-is-still-under-review" atlas:name="Told the refund transfer is still under review">
      <atlas:meta>
        <atlas:description>A card says the refund transfer is still being checked.</atlas:description>
        <atlas:snapshot>told-the-refund-transfer-is-still-under-review</atlas:snapshot>
        <atlas:confidence>assumed</atlas:confidence>
        <atlas:source>src/screens/told-the-refund-transfer-is-still-under-review.tsx</atlas:source>
      </atlas:meta>
      <transition event="checks-the-refund-transfer-again" target="waiting-for-the-refund-transfer-to-be-approved" atlas:name="Checks the refund transfer again"/>
    </state>
    <state id="told-the-refund-transfer-was-rejected" atlas:name="Told the refund transfer was rejected">
      <atlas:meta>
