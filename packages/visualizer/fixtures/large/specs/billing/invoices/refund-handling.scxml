        <atlas:snapshot>told-the-refund-approval-could-not-be-saved</atlas:snapshot>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/told-the-refund-approval-could-not-be-saved.tsx</atlas:source>
      </atlas:meta>
      <transition event="tries-saving-the-refund-approval-again" target="editing-the-refund-approval" atlas:name="Tries saving the refund approval again"/>
    </state>
    <state id="waiting-for-the-refund-approval-to-be-approved" atlas:name="Waiting for the refund approval to be approved">
      <atlas:meta>
        <atlas:description>A card says the refund approval is being checked.</atlas:description>
        <atlas:snapshot>waiting-for-the-refund-approval-to-be-approved</atlas:snapshot>
        <atlas:event>Refund approval submitted</atlas:event>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/waiting-for-the-refund-approval-to-be-approved.tsx</atlas:source>
        <atlas:tier>critical</atlas:tier>
      </atlas:meta>
      <transition event="billing-service-approves-the-refund-approval" target="told-the-refund-approval-was-approved" atlas:name="Billing service approves the refund approval"/>
      <transition event="billing-service-rejects-the-refund-approval" target="told-the-refund-approval-was-rejected" atlas:name="Billing service rejects the refund approval"/>
      <transition event="approval-of-the-refund-approval-takes-longer-than-a-day" target="told-the-refund-approval-is-still-under-review" atlas:name="Approval of the refund approval takes longer than a day"/>
    </state>
    <state id="told-the-refund-approval-is-still-under-review" atlas:name="Told the refund approval is still under review">
      <atlas:meta>
        <atlas:description>A card says the refund approval is still being checked.</atlas:description>
        <atlas:snapshot>told-the-refund-approval-is-still-under-review</atlas:snapshot>
        <atlas:confidence>assumed</atlas:confidence>
        <atlas:source>src/screens/told-the-refund-approval-is-still-under-review.tsx</atlas:source>
      </atlas:meta>
      <transition event="checks-the-refund-approval-again" target="waiting-for-the-refund-approval-to-be-approved" atlas:name="Checks the refund approval again"/>
    </state>
    <state id="told-the-refund-approval-was-rejected" atlas:name="Told the refund approval was rejected">
      <atlas:meta>
        <atlas:description>A message explains why the refund approval was not accepted.</atlas:description>
        <atlas:snapshot>told-the-refund-approval-was-rejected</atlas:snapshot>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/told-the-refund-approval-was-rejected.tsx</atlas:source>
      </atlas:meta>
      <transition event="starts-the-refund-approval-again" target="reviewing-the-refund-approval" atlas:name="Starts the refund approval again"/>
    </state>
    <state id="told-the-refund-approval-was-approved" atlas:name="Told the refund approval was approved">
      <atlas:meta>
        <atlas:description>A message confirms the refund approval is approved.</atlas:description>
        <atlas:snapshot>told-the-refund-approval-was-approved</atlas:snapshot>
        <atlas:event>Refund approval approved</atlas:event>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/told-the-refund-approval-was-approved.tsx</atlas:source>
      </atlas:meta>
      <transition event="continues-to-the-refund-transfer" target="handling-the-refund-transfer" atlas:name="Continues to the refund transfer"/>
    </state>
  </state>
  <state id="handling-the-refund-transfer" atlas:name="Handling the refund transfer" initial="reviewing-the-refund-transfer">
    <atlas:meta>
      <atlas:description>Everything about the refund transfer, from review to approval.</atlas:description>
      <atlas:snapshot>handling-the-refund-transfer</atlas:snapshot>
      <atlas:confidence>confirmed</atlas:confidence>
      <atlas:source>src/screens/handling-the-refund-transfer.tsx</atlas:source>
      <atlas:owner>Billing team</atlas:owner>
    </atlas:meta>
    <state id="reviewing-the-refund-transfer" atlas:name="Reviewing the refund transfer">
      <atlas:meta>
        <atlas:description>The user checks the refund transfer before sending it.</atlas:description>
        <atlas:snapshot>reviewing-the-refund-transfer</atlas:snapshot>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/reviewing-the-refund-transfer.tsx</atlas:source>
        <atlas:gherkin>[&quot;features/billing/invoices/refund-transfer.feature&quot;]</atlas:gherkin>
      </atlas:meta>
      <transition event="taps-edit-on-the-refund-transfer" target="editing-the-refund-transfer" atlas:name="Taps edit on the refund transfer"/>
      <transition event="submits-the-refund-transfer" target="waiting-for-the-refund-transfer-to-be-approved" atlas:name="Submits the refund transfer"/>
    </state>
    <state id="editing-the-refund-transfer" atlas:name="Editing the refund transfer">
      <atlas:meta>
        <atlas:description>A form to change the refund transfer.</atlas:description>
        <atlas:snapshot>editing-the-refund-transfer</atlas:snapshot>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/editing-the-refund-transfer.tsx</atlas:source>
      </atlas:meta>
      <transition event="saves-the-refund-transfer" target="reviewing-the-refund-transfer" atlas:name="Saves the refund transfer"/>
      <transition event="cancels-the-changes-to-the-refund-transfer" target="reviewing-the-refund-transfer" atlas:name="Cancels the changes to the refund transfer"/>
      <transition event="saving-the-refund-transfer-fails" target="told-the-refund-transfer-could-not-be-saved" atlas:name="Saving the refund transfer fails"/>
    </state>
    <state id="told-the-refund-transfer-could-not-be-saved" atlas:name="Told the refund transfer could not be saved">
      <atlas:meta>
