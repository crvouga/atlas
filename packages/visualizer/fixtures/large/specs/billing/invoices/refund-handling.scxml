  <final id="refund-handling-completed" atlas:name="Refund handling completed" atlas:done-event="Refund handling is completed">
    <atlas:meta>
      <atlas:description>The refund handling is done.</atlas:description>
      <atlas:snapshot>refund-handling-completed</atlas:snapshot>
      <atlas:event>Refund handling completed</atlas:event>
      <atlas:confidence>confirmed</atlas:confidence>
      <atlas:source>src/screens/refund-handling-completed.tsx</atlas:source>
    </atlas:meta>
  </final>
  <final id="refund-handling-abandoned" atlas:name="Refund handling abandoned" atlas:done-event="Refund handling is abandoned">
    <atlas:meta>
      <atlas:description>The user left the refund handling before the end.</atlas:description>
      <atlas:snapshot>refund-handling-abandoned</atlas:snapshot>
      <atlas:confidence>confirmed</atlas:confidence>
      <atlas:source>src/screens/refund-handling-abandoned.tsx</atlas:source>
    </atlas:meta>
