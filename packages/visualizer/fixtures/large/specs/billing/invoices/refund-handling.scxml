      <transition event="submits-the-refund-approval" target="waiting-for-the-refund-approval-to-be-approved" atlas:name="Submits the refund approval"/>
    </state>
    <state id="editing-the-refund-approval" atlas:name="Editing the refund approval">
      <atlas:meta>
        <atlas:description>A form to change the refund approval.</atlas:description>
        <atlas:snapshot>editing-the-refund-approval</atlas:snapshot>
        <atlas:confidence>confirmed</atlas:confidence>
        <atlas:source>src/screens/editing-the-refund-approval.tsx</atlas:source>
