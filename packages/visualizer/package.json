{
  "name": "@crvouga/atlas-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas visualizer: browse statechart specs (W3C SCXML or XState) and the runs that execute them, with screenshots, clips and statuses.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/crvouga/atlas",
    "directory": "packages/visualizer"
  },
  "keywords": [
    "statecharts",
    "scxml",
    "xstate",
    "visualizer",
    "model-based-testing"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "atlas-visualizer": "./bin/atlas-visualizer.mjs"
  },
  "files": [
    "bin",
    "example",
    "fixtures",
    "index.html",
    "scripts",
    "src",
    "vite",
    "vite.config.ts",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "publish-data": "tsx scripts/publish-data.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:check": "vitest run"
  },
  "dependencies": {
    "@crvouga/atlas": "workspace:*",
    "@crvouga/atlas-schema": "workspace:*",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.41",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "^12.11.5",
    "cmdk": "^1.1.1",
    "elkjs": "0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "7.3.6",
    "xstate": "5.33.2",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.11.1",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
