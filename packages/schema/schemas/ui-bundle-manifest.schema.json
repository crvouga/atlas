{
  "$id": "https://github.com/crvouga/atlas/schemas/ui-bundle-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "atlas-ui-catalog-bundle"
    },
    "definition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "version",
            "name"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ],
      "description": "Null until the shard knew its definition"
    },
    "refresh": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sha",
        "branch"
      ],
      "additionalProperties": {}
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shard": {
            "type": "string"
          },
          "participant": {
            "type": "string"
          },
          "attempt": {
            "type": "string"
          },
          "startedAtMs": {
            "type": "number"
          }
        },
        "required": [
          "shard",
          "participant",
          "attempt",
          "startedAtMs"
        ],
        "additionalProperties": {}
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layer": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recordedAtMs": {
            "type": "number"
          }
        },
        "required": [
          "layer",
          "recordedAtMs"
        ],
        "additionalProperties": {}
      },
      "description": "The definition's plan layers, so an offline export expects every item"
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layer": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recordedAtMs": {
            "type": "number"
          },
          "shard": {
            "type": "string"
          },
          "participant": {
            "type": "string"
          },
          "attempt": {
            "type": "string"
          },
          "claimId": {
            "type": [
              "string",
              "null"
            ]
          },
          "units": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "publication": {
            "type": "string",
            "enum": [
              "pending",
              "published",
              "failed"
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "layer",
          "recordedAtMs",
          "shard",
          "participant",
          "attempt",
          "claimId",
          "units",
          "items",
          "failed",
          "publication"
        ],
        "additionalProperties": {}
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": {}
      },
      "description": "Every object in `store/`, by its key there"
    },
    "updatedAtMs": {
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "definition",
    "refresh",
    "collection",
    "source",
    "attempts",
    "plans",
    "captures",
    "objects",
    "updatedAtMs"
  ],
  "additionalProperties": {}
}
