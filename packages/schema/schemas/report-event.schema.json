{
  "$id": "https://github.com/crvouga/atlas/schemas/report-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "description": "The report version after these layers",
      "type": "string"
    },
    "totalLayers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "added": {
      "description": "At most the 20 newest of the layers that arrived",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          },
          "environment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "recordedAtMs": {
            "type": "number"
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "running",
                "not-run"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "required": [
          "id",
          "producer",
          "recordedAtMs"
        ],
        "additionalProperties": {}
      }
    },
    "addedTotal": {
      "description": "How many layers arrived, including those not listed",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "totalLayers",
    "added",
    "addedTotal"
  ],
  "additionalProperties": {}
}
