{
  "$id": "https://github.com/crvouga/atlas/schemas/report-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "The report version after these layers"
    },
    "totalLayers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "recordedAtMs": {
            "type": "number"
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "running",
                "not-run"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "required": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          }
        },
        "required": [
          "id",
          "producer",
          "recordedAtMs"
        ],
        "additionalProperties": {}
      },
      "description": "At most the 20 newest of the layers that arrived"
    },
    "addedTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "How many layers arrived, including those not listed"
    }
  },
  "required": [
    "version",
    "totalLayers",
    "added",
    "addedTotal"
  ],
  "additionalProperties": {}
}
