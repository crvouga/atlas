{
  "$id": "https://github.com/crvouga/atlas/schemas/merge-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "into": {
      "type": "string"
    },
    "copied": {
      "description": "Objects that were missing in the destination and were copied",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "skipped": {
      "description": "Objects the destination already had",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ignored": {
      "description": "Objects outside `layers/`, which are never merged",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "ok",
    "into",
    "copied",
    "skipped",
    "ignored"
  ],
  "additionalProperties": {}
}
