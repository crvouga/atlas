{
  "$id": "https://github.com/crvouga/atlas/schemas/layer-rows.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "The kind of the part holding the check. Part of the slot"
          },
          "id": {
            "type": "string",
            "description": "The check id. Part of the slot"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          },
          "specPath": {
            "description": "The spec the check belongs to, `specs/<path>`, or null",
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string",
            "description": "Why it has this status; empty when there is nothing to add"
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "limit": {
                  "type": "number"
                }
              },
              "required": [
                "name",
                "value",
                "unit"
              ],
              "additionalProperties": {}
            }
          },
          "testId": {
            "type": [
              "string",
              "null"
            ]
          },
          "variant": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "durationMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "attachments": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "steps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "annotations": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "links": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "artifactTags": {
                "description": "Normalized tags of the attachments themselves, sorted and distinct. Absent when no attachment is tagged; never inherited from a check or run",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "labels": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "videos": {
                "description": "Its references to videos and who holds each. Absent when it has none, and in reports written before this was recorded",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The attachment name"
                    },
                    "owner": {
                      "type": "string",
                      "description": "Who holds it: `layer`, `check`, `attempt` or `step`. An open vocabulary: treat an unknown owner as a check"
                    },
                    "attempt": {
                      "description": "The retry attempt that holds it, or that holds the step that does",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "step": {
                      "description": "The name of the step that holds it",
                      "type": "string"
                    },
                    "recording": {
                      "description": "What identifies the bytes; references with the same value are one recording. Absent when it cannot be played",
                      "type": "string"
                    },
                    "available": {
                      "type": "boolean",
                      "description": "False when the reference names no bytes (no bundle key, address or inline text)"
                    }
                  },
                  "required": [
                    "name",
                    "owner",
                    "available"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "attachments",
              "steps",
              "annotations",
              "attempts",
              "links",
              "tags",
              "labels",
              "roles"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "kind",
          "id",
          "title",
          "status",
          "specPath",
          "detail",
          "measurements",
          "testId",
          "variant",
          "durationMs"
        ],
        "additionalProperties": {}
      }
    },
    "fingerprints": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Spec path to the fingerprint the layer recorded for it"
    }
  },
  "required": [
    "id",
    "rows",
    "fingerprints"
  ],
  "additionalProperties": {}
}
