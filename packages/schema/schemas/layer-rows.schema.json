{
  "$id": "https://github.com/crvouga/atlas/schemas/layer-rows.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "The kind of the part holding the check. Part of the slot"
          },
          "id": {
            "type": "string",
            "description": "The check id. Part of the slot"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          },
          "specPath": {
            "description": "The spec the check belongs to, `specs/<path>`, or null",
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string",
            "description": "Why it has this status; empty when there is nothing to add"
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "limit": {
                  "type": "number"
                }
              },
              "required": [
                "name",
                "value",
                "unit"
              ],
              "additionalProperties": {}
            }
          },
          "testId": {
            "type": [
              "string",
              "null"
            ]
          },
          "variant": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "durationMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "attachments": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "steps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "annotations": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "links": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "artifactTags": {
                "description": "Normalized tags of the attachments themselves, sorted and distinct. Absent when no attachment is tagged; never inherited from a check or run",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "labels": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "videos": {
                "description": "Its references to videos and who holds each. Absent when it has none, and in reports written before this was recorded",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The attachment name"
                    },
                    "owner": {
                      "type": "string",
                      "description": "Who holds it: `layer`, `check`, `attempt` or `step`. An open vocabulary: treat an unknown owner as a check"
                    },
                    "attempt": {
                      "description": "The retry attempt that holds it, or that holds the step that does",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "step": {
                      "description": "The name of the step that holds it",
                      "type": "string"
                    },
                    "tags": {
                      "description": "The normalized tags of this attachment itself. Absent when it has none (and in documents of older servers)",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "recording": {
                      "description": "What identifies the bytes; references with the same value are one recording. Absent when it cannot be played",
                      "type": "string"
                    },
                    "available": {
                      "type": "boolean",
                      "description": "False when the reference names no bytes (no bundle key, address or inline text)"
                    },
                    "scope": {
                      "description": "What this recording shows as its producer declared it: its own `scope`, else its attempt's, check's, part's or layer's. Absent: the scope is unknown, never live, physical or audible",
                      "type": "object",
                      "properties": {
                        "surface": {
                          "description": "Where the product ran, in an open vocabulary: `browser`, `native-app`, `api`, `cli`…",
                          "type": "string",
                          "minLength": 1
                        },
                        "deviceKind": {
                          "description": "What it ran on, in an open vocabulary: `simulator`, `emulator`, `physical`, `virtual-machine`, `desktop`… A simulator and a physical phone stay distinct values; they are filtered separately",
                          "type": "string",
                          "minLength": 1
                        },
                        "syntheticData": {
                          "description": "True: the data was made up for the run. False: real data. Absent: unknown",
                          "type": "boolean"
                        },
                        "dependencies": {
                          "description": "Whether what the product talks to was `scripted` (replies fixed in advance), `live` or `mixed`. An open vocabulary; absent is unknown",
                          "type": "string",
                          "minLength": 1
                        },
                        "audioCaptured": {
                          "description": "True: the recording has real audio. False: it is silent. Absent: unknown",
                          "type": "boolean"
                        },
                        "pacing": {
                          "description": "How time ran, in an open vocabulary: `paced` (slowed or scripted for a viewer), `real-time`. Absent: unknown",
                          "type": "string",
                          "minLength": 1
                        },
                        "asserted": {
                          "description": "The boundaries the result actually asserts. Activity visible in a recording beyond them is not verified behavior",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "limitations": {
                          "description": "Known limits of what this evidence shows, in the producer's words",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "declaredBy": {
                          "description": "Who or what made this declaration: a tool, a team, a person",
                          "type": "string"
                        },
                        "verified": {
                          "description": "The names of the fields above (`surface`, `deviceKind`, `syntheticData`, `dependencies`, `audioCaptured`, `pacing`) that something independent of the producer checked. Every other field is only declared",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "verifiedBy": {
                          "description": "What checked the `verified` fields",
                          "type": "string"
                        },
                        "provenance": {
                          "description": "Where the declaration comes from and how to check it: a document, a CI step, a device log",
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string",
                                "minLength": 1
                              },
                              "name": {
                                "type": "string"
                              },
                              "rel": {
                                "description": "Why it is linked, in an open vocabulary: issue, run, trace, docs, source…",
                                "type": "string"
                              }
                            },
                            "required": [
                              "url"
                            ],
                            "additionalProperties": {}
                          }
                        },
                        "extensions": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1
                          },
                          "additionalProperties": {}
                        }
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "name",
                    "owner",
                    "available"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "attachments",
              "steps",
              "annotations",
              "attempts",
              "links",
              "tags",
              "labels",
              "roles"
            ],
            "additionalProperties": {}
          },
          "recording": {
            "description": "What became of the check's expected recording: uploaded, referenced, skipped, unresolved or not-applicable. Independent of `status`",
            "type": "object",
            "properties": {
              "state": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "kind",
          "id",
          "title",
          "status",
          "specPath",
          "detail",
          "measurements",
          "testId",
          "variant",
          "durationMs"
        ],
        "additionalProperties": {}
      }
    },
    "fingerprints": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Spec path to the fingerprint the layer recorded for it"
    }
  },
  "required": [
    "id",
    "rows",
    "fingerprints"
  ],
  "additionalProperties": {}
}
