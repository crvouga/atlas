{
  "$id": "https://github.com/crvouga/atlas/schemas/ui-catalog-export-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "out": {
      "type": "string",
      "description": "The HTML file that was written"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Its size"
    },
    "states": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cells": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pictures": {
      "type": "object",
      "properties": {
        "embedded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "embeddedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Pictures not embedded (over the size limit, not stored, not an image, or `--images none`); each is listed on the page with the reason"
        }
      },
      "required": [
        "embedded",
        "embeddedBytes",
        "left"
      ],
      "additionalProperties": {}
    },
    "manifest": {
      "description": "The JSON manifest written beside it with `--manifest`, or null",
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Backends and layers that could not be read, and pictures left out. The page says so too"
    },
    "scope": {
      "description": "With `--definition` or `--catalog`: which history the page counts",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "`all-history` or `definition`"
        },
        "status": {
          "type": "string",
          "description": "`applied` or `unavailable`; any other value is an unknown scope"
        },
        "definition": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "description": "The SHA-256 of the canonical definition"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "version",
            "name"
          ],
          "additionalProperties": {}
        },
        "expected": {
          "description": "What the definition expects: its states, its profiles and their product",
          "type": "object",
          "properties": {
            "states": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "profiles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "states",
            "profiles",
            "cells"
          ],
          "additionalProperties": {}
        },
        "excluded": {
          "description": "Recorded history outside the definition: not counted in this document, still in the layers",
          "type": "object",
          "properties": {
            "states": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "profiles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "coverage": {
              "type": "object",
              "properties": {
                "captured": {
                  "type": "number"
                },
                "failed": {
                  "type": "number"
                },
                "capturing": {
                  "type": "number"
                },
                "skipped": {
                  "type": "number"
                },
                "missing": {
                  "type": "number"
                }
              },
              "required": [
                "captured",
                "failed",
                "capturing",
                "skipped",
                "missing"
              ],
              "additionalProperties": {}
            }
          },
          "required": [
            "states",
            "profiles",
            "cells",
            "coverage"
          ],
          "additionalProperties": {}
        },
        "reason": {
          "description": "Why the scope is unavailable",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "status"
      ],
      "additionalProperties": {}
    },
    "summary": {
      "description": "With a scope: the counts of the page, the same as `status` gives for that scope",
      "type": "object",
      "properties": {
        "states": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "profiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "States counted once per profile"
        },
        "coverage": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "captured",
              "failed",
              "capturing",
              "skipped",
              "missing"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required": [
            "captured",
            "failed",
            "capturing",
            "skipped",
            "missing"
          ],
          "description": "Cells by coverage"
        },
        "undeclared": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Captured cells no plan expects; zero when no plan exists"
        },
        "planned": {
          "type": "boolean",
          "description": "Whether any plan was published. Without one, `missing` is always zero because what should exist is unknown"
        },
        "surfaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncoveredSurfaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "states",
        "profiles",
        "cells",
        "coverage",
        "undeclared",
        "planned",
        "surfaces",
        "uncoveredSurfaces"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "ok",
    "out",
    "bytes",
    "states",
    "cells",
    "pictures",
    "manifest",
    "warnings"
  ],
  "additionalProperties": {}
}
