{
  "$id": "https://github.com/crvouga/atlas/schemas/report-runs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The run URL, or `branch@sha`. Pass it to `/api/reports/runs/detail?key=` or `/api/reports/tests?run=`"
          },
          "runUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAtMs": {
            "type": "number"
          },
          "endedAtMs": {
            "type": "number"
          },
          "spanMs": {
            "type": "number"
          },
          "producers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "running",
                "not-run"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "required": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          },
          "totalDurationMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "failing": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "environment": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "title",
                "environment",
                "detail"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "key",
          "runUrl",
          "branch",
          "sha",
          "startedAtMs",
          "endedAtMs",
          "spanMs",
          "producers",
          "environments",
          "layers",
          "tests",
          "counts",
          "totalDurationMs",
          "failing"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "total",
    "runs"
  ],
  "additionalProperties": {}
}
