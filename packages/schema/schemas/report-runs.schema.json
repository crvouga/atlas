{
  "$id": "https://github.com/crvouga/atlas/schemas/report-runs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Runs that matched, before `limit`"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "`run:<id>` for an execution a producer named, else the run URL, else `branch@sha`. Pass it to `/api/reports/runs/detail?key=` or `/api/reports/tests?run=`"
          },
          "runId": {
            "description": "The execution id the producer named, when it did. Layers that share it are one run however many uploads they took",
            "type": "string"
          },
          "title": {
            "description": "The human title of the execution (the newest layer's). Presentation only: the key, commit and `freshness` are unaffected",
            "type": "string"
          },
          "freshness": {
            "description": "`modified` when any layer of the run was recorded from a checkout with uncommitted changes; `unknown` when an origin was not captured; absent when all are clean. Shown beside the commit, never replaced by the title",
            "type": "string",
            "enum": [
              "unknown",
              "modified"
            ]
          },
          "runUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAtMs": {
            "type": "number"
          },
          "endedAtMs": {
            "type": "number"
          },
          "spanMs": {
            "type": "number"
          },
          "producers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "running",
                "not-run"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "required": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          },
          "totalDurationMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "failing": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "environment": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "title",
                "environment",
                "detail"
              ],
              "additionalProperties": {}
            }
          },
          "videos": {
            "description": "Its videos, from its layers and the last result of each test. Absent when it has none or the report carries no video information",
            "type": "object",
            "properties": {
              "references": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Every reference to a video; identical bytes referenced twice count twice"
              },
              "recordings": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Distinct playable recordings"
              },
              "unavailable": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "References that name no bytes"
              }
            },
            "required": [
              "references",
              "recordings",
              "unavailable"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "key",
          "runUrl",
          "branch",
          "sha",
          "startedAtMs",
          "endedAtMs",
          "spanMs",
          "producers",
          "environments",
          "layers",
          "tests",
          "counts",
          "totalDurationMs",
          "failing"
        ],
        "additionalProperties": {}
      }
    },
    "withVideo": {
      "description": "How many of all runs (before `video` and `limit`) have a playable video recording",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "total",
    "runs"
  ],
  "additionalProperties": {}
}
