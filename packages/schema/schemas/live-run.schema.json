{
  "$id": "https://github.com/crvouga/atlas/schemas/live-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "maxLength": 2048
    },
    "environment": {
      "type": "string",
      "maxLength": 200
    },
    "branch": {
      "type": "string",
      "maxLength": 500
    },
    "sha": {
      "type": "string",
      "maxLength": 200
    },
    "plannedChecks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "interrupted"
      ]
    },
    "startedAtMs": {
      "type": "number"
    },
    "lastHeartbeatAtMs": {
      "type": "number"
    },
    "lastProgressAtMs": {
      "type": "number"
    },
    "finishedAtMs": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "sequence": {
      "type": "number"
    },
    "completed": {
      "type": "number"
    },
    "passed": {
      "type": "number"
    },
    "failed": {
      "type": "number"
    },
    "notRun": {
      "type": "number"
    },
    "running": {
      "type": "number"
    },
    "current": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "passed",
              "failed",
              "not-run"
            ]
          },
          "detail": {
            "default": "",
            "type": "string",
            "maxLength": 8000
          },
          "specPath": {
            "type": "string",
            "maxLength": 2048
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "steps": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 2048
                },
                "status": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ]
      }
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "passed",
              "failed",
              "not-run"
            ]
          },
          "detail": {
            "default": "",
            "type": "string",
            "maxLength": 8000
          },
          "specPath": {
            "type": "string",
            "maxLength": 2048
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "steps": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 2048
                },
                "status": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ]
      }
    }
  },
  "required": [
    "id",
    "producer",
    "status",
    "startedAtMs",
    "lastHeartbeatAtMs",
    "lastProgressAtMs",
    "sequence",
    "completed",
    "passed",
    "failed",
    "notRun",
    "running",
    "current",
    "recent"
  ]
}
