{
  "$id": "https://github.com/crvouga/atlas/schemas/state-node.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "initial": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "parallel",
        "final"
      ]
    },
    "meta": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Business events that happen on entering the state"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "confirmed",
            "assumed"
          ]
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "childMachine": {
          "type": "string"
        },
        "childFinalEvents": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "deadEnd": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "quint": {
          "type": "string",
          "description": "Quint model reference"
        },
        "gherkin": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Feature files or scenarios that cover the state"
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "keyword": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string"
                    },
                    "table": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "docString": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "keyword",
                    "text"
                  ]
                }
              }
            },
            "required": [
              "id",
              "name",
              "source",
              "steps"
            ]
          },
          "description": "Business rules and their exact Given/When/Then examples, copied from the authoritative source"
        },
        "design": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1,
              "description": "URL or spec-relative path of a design frame"
            },
            "url": {
              "description": "Where the design lives, for example a Figma frame link",
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "image"
          ]
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What the screen shows, for the placeholder sketch"
        },
        "eventKinds": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "user",
              "system",
              "time",
              "hand-off"
            ]
          },
          "description": "Chart-level: who or what sends each event; overrides the runner and the guess"
        },
        "timeEvents": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Chart-level: time events and the span each one jumps, for example \"5 minutes\""
        }
      }
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#"
      }
    },
    "on": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "meta": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "target"
            ]
          }
        ]
      }
    }
  }
}
