{
  "$id": "https://github.com/crvouga/atlas/schemas/critic-run-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "False when a critic failed on any entry or a gate was crossed (the exit code is then 1)"
    },
    "dryRun": {
      "type": "boolean"
    },
    "server": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "The choices that narrowed the catalog, as given"
    },
    "critics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "critic": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sendsImagesTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "entries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Entries in the chosen scope"
          },
          "judged": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skipped": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Entries that already had a current critique of the same identity (critic, version, model, parameters, image hash): no call was made"
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Entries recorded as failed with a reason code; the next run retries them"
          },
          "waiting": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Entries left unjudged because the run stopped"
          },
          "stoppedBy": {
            "type": "string",
            "enum": [
              "budget",
              "aborted"
            ]
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entry": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "entry",
                "reason"
              ],
              "additionalProperties": {}
            },
            "description": "Each failed entry and its reason code"
          },
          "spent": {
            "type": "object",
            "properties": {
              "images": {
                "type": "number"
              },
              "tokens": {
                "type": "number"
              },
              "costUsd": {
                "type": "number"
              }
            },
            "required": [
              "images",
              "tokens",
              "costUsd"
            ],
            "additionalProperties": {}
          },
          "published": {
            "type": "object",
            "properties": {
              "layer": {
                "description": "The layer id of the critiques, or null when nothing was published (a dry run, or nothing to publish)",
                "type": [
                  "string",
                  "null"
                ]
              },
              "critiques": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "layer",
              "critiques"
            ],
            "additionalProperties": {}
          },
          "gate": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "report",
                  "warn",
                  "gate"
                ]
              },
              "exitCode": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "below": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Scores below their state kind's threshold"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "refusal": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Why `gate` was refused, when it was"
              }
            },
            "required": [
              "mode",
              "exitCode",
              "below",
              "warnings",
              "refusal"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "critic",
          "version",
          "sendsImagesTo",
          "entries",
          "judged",
          "skipped",
          "failed",
          "waiting",
          "failures",
          "spent",
          "published"
        ],
        "additionalProperties": {}
      }
    },
    "spool": {
      "type": "object",
      "properties": {
        "flushed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Objects from an earlier run that were sent now"
        },
        "spooled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Objects of this run kept locally because the server could not be reached; the next invocation sends them"
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Objects still waiting in the spool"
        }
      },
      "required": [
        "flushed",
        "spooled",
        "pending"
      ],
      "additionalProperties": {}
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "ok",
    "dryRun",
    "server",
    "scope",
    "critics",
    "spool",
    "warnings"
  ],
  "additionalProperties": {}
}
