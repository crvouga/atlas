{
  "$id": "https://github.com/crvouga/atlas/schemas/critique.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "The version of this extension. 1"
    },
    "subject": {
      "type": "object",
      "properties": {
        "entryKey": {
          "type": "string",
          "minLength": 1,
          "description": "The catalog entry that was judged"
        },
        "imageSha256": {
          "type": "string",
          "minLength": 1,
          "description": "The hash of the exact image bytes that were judged. When the entry's image changes, this critique judged an earlier image"
        },
        "state": {
          "description": "The kind of UI state: `screen`, `overlay`, `loading`, `error`, `empty`…",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entryKey",
        "imageSha256"
      ],
      "additionalProperties": {}
    },
    "critic": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Of the critic's own logic. A newer version replaces an older one"
        },
        "kind": {
          "description": "Open vocabulary: `model`, `llm`, `ml`, `heuristic`…",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": {}
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": {}
    },
    "parameters": {
      "description": "Everything else that explains the result: temperature, seed, the SHA-256 of the rubric",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "verdict": {
      "type": "object",
      "properties": {
        "score": {
          "description": "A finite number. `scale` says what it means",
          "type": "number"
        },
        "scale": {
          "description": "For example `0..1, higher is better`",
          "type": "string"
        },
        "label": {
          "description": "Open vocabulary, conventionally `ok` or `needs-polish`",
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "relative": {
          "type": "object",
          "properties": {
            "stateKind": {
              "type": "string",
              "minLength": 1,
              "description": "The kind of UI state the score is relative to: `screen`, `overlay`, `loading`, `error`, `empty`…"
            },
            "percentile": {
              "description": "Where the score falls among the project's scores of the same state kind, 0..100, higher is better",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sampleSize": {
              "description": "How many scores of that state kind the percentile is over",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "previousScore": {
              "description": "The same entry's score for its previous image, from the same critic",
              "type": "number"
            },
            "delta": {
              "description": "`score` minus `previousScore`",
              "type": "number"
            }
          },
          "required": [
            "stateKind"
          ],
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Stable within the critique, so a reviewer can mark this finding valid or not",
            "type": "string",
            "minLength": 1
          },
          "category": {
            "description": "Open vocabulary: `spacing`, `contrast`, `alignment`, `overflow`, `hierarchy`…",
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "description": "Open vocabulary, conventionally `info`, `minor`, `major`",
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "region": {
            "type": "object",
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1,
                "description": "`px` (pixels of the stored image) or `normalized` (0..1 of its width and height). Open vocabulary"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number",
                "minimum": 0
              },
              "h": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "unit",
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": {}
          },
          "rationale": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      }
    },
    "failure": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": {}
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "number",
          "minimum": 0
        },
        "outputTokens": {
          "type": "number",
          "minimum": 0
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema",
    "subject",
    "critic"
  ],
  "additionalProperties": {}
}
