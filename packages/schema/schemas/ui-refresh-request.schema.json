{
  "$id": "https://github.com/crvouga/atlas/schemas/ui-refresh-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "definition": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "The version of a published definition"
    },
    "collection": {
      "description": "What its shards claim under, so retry limits are counted per refresh. Default: the refresh id",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "type": "object",
      "properties": {
        "sha": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "branch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "require": {
          "description": "Only evidence recorded at this commit satisfies the refresh. Default false: the source is provenance",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "where": {
      "description": "The profiles in scope: only units whose every item has one of these values in each named dimension",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "staleBeforeMs": {
      "description": "Only evidence recorded at or after this time satisfies the refresh. Default: when it began",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "participants": {
      "description": "Optional names of the jobs expected to join, to diagnose one that never started. Never required for elastic workers",
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "definition"
  ],
  "additionalProperties": false
}
