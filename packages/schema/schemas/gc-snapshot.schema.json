{
  "$id": "https://github.com/crvouga/atlas/schemas/gc-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Delete eligible layers on a schedule. `false` keeps the policy but deletes nothing"
            },
            "maxAgeDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "description": "A superseded layer is eligible once it was recorded more than this many days ago"
            },
            "keepLatest": {
              "default": 20,
              "description": "Always keep this many of the newest layers, however old, so recent history stays",
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "intervalHours": {
              "default": 24,
              "description": "How often the server applies the policy",
              "type": "number",
              "minimum": 1,
              "maximum": 720
            }
          },
          "required": [
            "enabled",
            "maxAgeDays"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "saved": {
      "type": "boolean",
      "description": "Whether a policy exists in S3. `false` means garbage collection is off: nothing is deleted"
    },
    "lastRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "dryRun": {
            "type": "boolean"
          },
          "at": {
            "type": "string",
            "description": "When the pass finished, ISO 8601"
          },
          "candidates": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Layers the policy would delete"
          },
          "deletedLayers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deletedBlobs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "keptLayers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "description": "Why the pass stopped early, when it did",
            "type": "string"
          }
        },
        "required": [
          "project",
          "dryRun",
          "at",
          "candidates",
          "deletedLayers",
          "deletedBlobs",
          "keptLayers"
        ],
        "additionalProperties": {}
      },
      "description": "The most recent pass over each project, newest first; empty before the first pass"
    },
    "stateKey": {
      "type": "string",
      "description": "Where the user state lives in the bucket, relative to the configured prefix"
    }
  },
  "required": [
    "revision",
    "policy",
    "saved",
    "lastRuns",
    "stateKey"
  ],
  "additionalProperties": {}
}
