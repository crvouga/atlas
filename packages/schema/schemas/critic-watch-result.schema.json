{
  "$id": "https://github.com/crvouga/atlas/schemas/critic-watch-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "False when a critic failed on any entry (the exit code is then 1)"
    },
    "dryRun": {
      "type": "boolean"
    },
    "server": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "The choices that narrowed the catalog, as given"
    },
    "stoppedBy": {
      "type": "string",
      "enum": [
        "interrupted",
        "max-batches",
        "budget",
        "dry-run"
      ],
      "description": "Why the watch ended: Ctrl-C or a signal, `--max-batches`, a budget for the whole watch, or a dry run (one read)"
    },
    "batches": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "How many times the catalog handed over something new, the catch-up on connecting included"
    },
    "version": {
      "description": "The report version the watch had reached: resume with `--since` this. Null when nothing was read",
      "type": [
        "string",
        "null"
      ]
    },
    "critics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "critic": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sendsImagesTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "entries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Entries handed over by the catalog, counting a changed picture again"
          },
          "judged": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skipped": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Entries that already had a current critique of the same identity: no call was made"
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Entries recorded as failed with a reason code; the next batch that brings them, or the next run, retries them"
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entry": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "entry",
                "reason"
              ],
              "additionalProperties": {}
            }
          },
          "spent": {
            "type": "object",
            "properties": {
              "images": {
                "type": "number"
              },
              "tokens": {
                "type": "number"
              },
              "costUsd": {
                "type": "number"
              }
            },
            "required": [
              "images",
              "tokens",
              "costUsd"
            ],
            "additionalProperties": {}
          },
          "published": {
            "type": "object",
            "properties": {
              "layers": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "critiques": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "layers",
              "critiques"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "critic",
          "version",
          "sendsImagesTo",
          "entries",
          "judged",
          "skipped",
          "failed",
          "failures",
          "spent",
          "published"
        ],
        "additionalProperties": {}
      }
    },
    "spool": {
      "type": "object",
      "properties": {
        "flushed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "spooled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "flushed",
        "spooled",
        "pending"
      ],
      "additionalProperties": {},
      "description": "As for `critic-run-result`"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "ok",
    "dryRun",
    "server",
    "scope",
    "stoppedBy",
    "batches",
    "version",
    "critics",
    "spool",
    "warnings"
  ],
  "additionalProperties": {}
}
