      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The check's stable identity within its producer. The same check must keep the same id in every layer, or layers cannot replace one another"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          },
          "detail": {
            "default": "",
            "description": "Why it failed, or what was measured",
            "type": "string"
          },
          "specPath": {
            "description": "The spec this check belongs to, relative to the repository, such as specs/join.feature",
            "type": "string"
          },
          "measurements": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number",
                  "description": "A finite number"
                },
                "unit": {
                  "type": "string"
                },
                "limit": {
                  "description": "The allowance. A measurement over it is reported, and never fails the check by itself",
                  "type": "number"
                }
              },
              "required": [
                "name",
                "value",
                "unit"
              ],
              "additionalProperties": {}
            }
          },
          "durationMs": {
            "description": "How long the check took, when the producer measured it",
            "type": "number",
            "minimum": 0
          },
          "tags": {
            "description": "Free labels to filter and group by: smoke, slow, flaky…",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "description": "Facts about the result, not part of its identity: owner, severity, browser, os, build. Unlike `parameters` they never split a result into another slot",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string"
                },
