                  "minLength": 1
                },
                "role": {
                  "type": "string"
                },
                "contentType": {
                  "description": "An IANA media type. Absent means application/octet-stream",
                  "type": "string"
                },
                "bundleKey": {
                  "description": "The key of its bytes in the layer",
                  "type": "string"
                },
                "uri": {
                  "description": "Where else to read it: an https URL, or a path a host understands",
                  "type": "string"
                },
                "text": {
                  "description": "A small UTF-8 value, inline",
                  "type": "string"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string"
                },
                "width": {
                  "type": "number",
                  "minimum": 0
                },
                "height": {
                  "type": "number",
                  "minimum": 0
                },
