{
  "$id": "https://github.com/crvouga/atlas/schemas/atlas-change.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "specs",
        "runs"
      ]
    },
    "files": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceId": {
      "type": "string"
    },
    "liveRunId": {
      "description": "A live lease changed; its bounded snapshot is also sent as a run event",
      "type": "string"
    }
  },
  "required": [
    "scope"
  ]
}
