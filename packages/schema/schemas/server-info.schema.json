{
  "$id": "https://github.com/crvouga/atlas/schemas/server-info.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "atlas"
    },
    "version": {
      "description": "The @crvouga/atlas version the server runs, or null when it does not know",
      "type": [
        "string",
        "null"
      ]
    },
    "build": {
      "description": "Where this server was built from. Absent from a server that predates it, which means unknown",
      "type": "object",
      "properties": {
        "version": {
          "description": "The @crvouga/atlas version, or null for a source build or a build that does not know it",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "The source revision (a git commit) it was built from (`ATLAS_REVISION`), or null",
          "type": [
            "string",
            "null"
          ]
        },
        "builtAt": {
          "description": "When it was built, ISO 8601 (`ATLAS_BUILD_TIME`), or null",
          "type": [
            "string",
            "null"
          ]
        },
        "imageDigest": {
          "description": "The container image digest, only when the deployment injected it (`ATLAS_IMAGE_DIGEST`); an image cannot know its own digest, so null otherwise. Absent for a viewer",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "version",
        "revision",
        "builtAt"
      ],
      "additionalProperties": {}
    },
    "role": {
      "type": "string",
      "enum": [
        "read",
        "critic",
        "publish",
        "admin"
      ],
      "description": "What the token of this request may do. A server with no tokens treats everyone as admin"
    },
    "open": {
      "type": "boolean",
      "description": "True when the server has no tokens at all"
    },
    "write": {
      "type": "string",
      "description": "The id of the backend uploads go to"
    },
    "ready": {
      "type": "boolean"
    },
    "viewers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Viewers connected to /api/events right now"
    },
    "time": {
      "type": "number",
      "description": "The server clock, epoch milliseconds"
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "write": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "available",
          "write"
        ],
        "additionalProperties": {}
      }
    },
    "layers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "slots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Features this server has, by name: `events`, `ingest`, `store`, `checks`, `status`, `effective`. A client checks a name before using what it names"
    }
  },
  "required": [
    "name",
    "version",
    "role",
    "open",
    "write",
    "ready",
    "viewers",
    "time",
    "backends",
    "layers",
    "slots",
    "capabilities"
  ],
  "additionalProperties": {}
}
