{
  "$id": "https://github.com/crvouga/atlas/schemas/layer.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "description": "The major version of this contract",
      "type": "number",
      "const": 1
    },
    "id": {
      "description": "64 lowercase hex digits. Opaque to readers",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer": {
      "description": "A stable name for the suite or tool. With the check id, environment and parameters it picks the slot a layer fills",
      "type": "string",
      "minLength": 1
    },
    "recordedAtMs": {
      "description": "When the checks ran, in epoch milliseconds. The newest completed result wins its slot",
      "type": "number",
      "minimum": 0
    },
    "sha": {
      "description": "The commit the checks ran against. Provenance only; it never partitions a report",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "description": "Provenance only",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "runUrl": {
      "description": "Where to read the CI run that produced it",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment": {
      "description": "The client that was checked: desktop-web, mobile-web, ios, android, or any other lowercase name",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "parameters": {
      "description": "Other choices that make a result its own slot, such as a device size",
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "freshness": {
      "description": "`modified`: recorded from a checkout with uncommitted changes. `unknown`: origin not captured",
      "type": "string",
      "enum": [
        "unknown",
        "modified"
      ]
    },
    "specs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "fingerprint": {
            "description": "Identity of the spec text the layer was recorded against, to warn when the spec changed since",
            "type": "string"
          }
        },
        "required": [
          "path",
          "domain",
          "kind",
          "title"
        ],
        "additionalProperties": {}
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "freshness": {
            "type": "string",
            "enum": [
              "unknown",
              "modified"
            ]
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "sha": {
            "description": "Repeats the layer sha; readers use the layer",
            "default": "",
            "type": "string"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "description": "An open category: behavior, performance, accessibility… A new kind needs no change to a reader",
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "recordedAtMs": {
            "type": "number",
            "minimum": 0
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "description": "The check's stable identity within its producer. The same check must keep the same id in every layer, or layers cannot replace one another",
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed",
                    "running",
                    "not-run"
                  ]
                },
                "detail": {
                  "description": "Why it failed, or what was measured",
                  "default": "",
                  "type": "string"
                },
                "specPath": {
                  "description": "The spec this check belongs to, relative to the repository, such as specs/join.feature",
                  "type": "string"
                },
                "measurements": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "description": "A finite number",
                        "type": "number"
                      },
                      "unit": {
                        "type": "string"
                      },
                      "limit": {
                        "description": "The allowance. A measurement over it is reported, and never fails the check by itself",
                        "type": "number"
                      }
                    },
                    "required": [
                      "name",
                      "value",
                      "unit"
                    ],
                    "additionalProperties": {}
                  }
                },
                "durationMs": {
                  "description": "How long the check took, when the producer measured it",
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "title",
                "status"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "recordedAtMs",
          "checks"
        ],
        "additionalProperties": {}
      }
    },
    "source": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "packageDir": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "skipped"
              ]
            },
            "updatedAtMs": {
              "type": "number",
              "minimum": 0
            },
            "environment": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "description": "The check's stable identity within its producer. The same check must keep the same id in every layer, or layers cannot replace one another",
                          "type": "string",
                          "minLength": 1
                        },
                        "title": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "passed",
                            "failed",
                            "running",
                            "not-run"
                          ]
                        },
                        "detail": {
                          "description": "Why it failed, or what was measured",
                          "default": "",
                          "type": "string"
                        },
                        "specPath": {
                          "description": "The spec this check belongs to, relative to the repository, such as specs/join.feature",
                          "type": "string"
                        },
                        "measurements": {
                          "default": [],
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "minLength": 1
                              },
                              "value": {
                                "description": "A finite number",
                                "type": "number"
                              },
                              "unit": {
                                "type": "string"
                              },
                              "limit": {
                                "description": "The allowance. A measurement over it is reported, and never fails the check by itself",
                                "type": "number"
                              }
                            },
                            "required": [
                              "name",
                              "value",
                              "unit"
                            ],
                            "additionalProperties": {}
                          }
                        },
                        "durationMs": {
                          "description": "How long the check took, when the producer measured it",
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "status"
                      ],
                      "additionalProperties": {}
                    }
                  }
                },
                "required": [
                  "kind",
                  "title",
                  "checks"
                ],
                "additionalProperties": {}
              }
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "testId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "passed",
                      "failed",
                      "skipped"
                    ]
                  },
                  "system": {
                    "default": "",
                    "type": "string"
                  },
                  "runtime": {
                    "default": "",
                    "type": "string"
                  },
                  "seed": {
                    "default": "",
                    "type": "string"
                  },
                  "durationMs": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "testId",
                  "title",
                  "status"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "source",
            "packageDir",
            "bucket",
            "status",
            "updatedAtMs",
            "tests"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "recording": {
      "default": null,
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "layer"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": {}
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "commit"
                },
                "sha": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "sha",
                "source"
              ],
              "additionalProperties": {}
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "bundle": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "contentType": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "blob": {
                  "type": "string"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "blob",
                "offset",
                "size"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "contentType",
          "parts"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "producer",
    "recordedAtMs",
    "sha",
    "branch",
    "runUrl",
    "parts"
  ],
  "additionalProperties": {}
}
