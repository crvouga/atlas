{
  "$id": "https://github.com/crvouga/atlas/schemas/stream-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "False when any check could not be sent (the exit code is then 1)"
    },
    "producer": {
      "type": "string"
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "layers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Layers that arrived"
    },
    "checks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Checks that arrived"
    },
    "lost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Checks that never arrived"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Input lines that were skipped, and sends that failed"
    }
  },
  "required": [
    "ok",
    "producer",
    "environment",
    "layers",
    "checks",
    "lost",
    "warnings"
  ],
  "additionalProperties": {}
}
