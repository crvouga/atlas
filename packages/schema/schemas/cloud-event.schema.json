{
  "$id": "https://github.com/crvouga/atlas/schemas/cloud-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "datacontenttype": {
      "type": "string"
    },
    "data": {}
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type"
  ],
  "additionalProperties": {}
}
