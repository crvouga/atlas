{
  "$id": "https://github.com/crvouga/atlas/schemas/report-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Why `ok` is false, in words. Empty when it is true"
    },
    "checks": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "not-run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "passed",
        "failed",
        "running",
        "not-run",
        "total"
      ]
    },
    "byEnvironment": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "passed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "running": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "not-run": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "passed",
          "failed",
          "running",
          "not-run",
          "total"
        ]
      }
    },
    "layers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Distinct layers read, across all backends"
    },
    "backends": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "available"
        ]
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What could not be read. Any notice fails the gate: unknown is not passed"
    },
    "specsWithoutEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specs of the outline with no result at all. The outline is `--specs <dir>`, or else the specs the layers recorded"
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Null for checks that name no spec in the outline",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "running": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "not-run": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "passed",
              "failed",
              "running",
              "not-run",
              "total"
            ]
          },
          "byEnvironment": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "passed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "running": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "not-run": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "passed",
                "failed",
                "running",
                "not-run",
                "total"
              ]
            }
          }
        },
        "required": [
          "path",
          "title",
          "kind",
          "checks",
          "byEnvironment"
        ],
        "additionalProperties": {}
      },
      "description": "The outcome of each spec, so a dashboard needs nothing else"
    },
    "failing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "spec": {
            "type": [
              "string",
              "null"
            ]
          },
          "check": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "failed",
              "running"
            ]
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "producer": {
            "type": "string"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "layer": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "runUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "spec",
          "check",
          "title",
          "status",
          "environment",
          "producer",
          "branch",
          "sha",
          "layer",
          "backend",
          "runUrl",
          "detail"
        ],
        "additionalProperties": {}
      },
      "description": "Each slot whose newest completed result failed, or that is still running"
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "reasons",
    "checks",
    "byEnvironment",
    "layers",
    "backends",
    "notices",
    "specsWithoutEvidence",
    "specs",
    "failing"
  ],
  "additionalProperties": {}
}
