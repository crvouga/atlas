{
  "$id": "https://github.com/crvouga/atlas/schemas/run-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "specVersion": {
      "type": "string"
    },
    "progress": {
      "description": "Absent means complete",
      "type": "string",
      "enum": [
        "running",
        "complete"
      ]
    },
    "execution": {
      "type": "object",
      "properties": {
        "totalPaths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completedPaths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "activePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "totalPaths",
        "completedPaths",
        "activePaths",
        "updatedAt"
      ]
    },
    "hasManifest": {
      "description": "False while the first snapshot has not arrived",
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "states": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "flaky": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "notReached": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "passed",
            "failed",
            "flaky",
            "notReached"
          ]
        },
        "transitions": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "flaky": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "notReached": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "passed",
            "failed",
            "flaky",
            "notReached"
          ]
        }
      }
    },
    "journeys": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "flaky": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notReached": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "flaky",
        "notReached"
      ]
    }
  },
  "required": [
    "id",
    "startedAt"
  ]
}
