{
  "$id": "https://github.com/crvouga/atlas/schemas/live-run-update.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "checks": {
      "default": [],
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "passed",
              "failed",
              "not-run"
            ]
          },
          "detail": {
            "default": "",
            "type": "string",
            "maxLength": 8000
          },
          "specPath": {
            "type": "string",
            "maxLength": 2048
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "steps": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 2048
                },
                "status": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ]
      }
    },
    "finish": {
      "type": "string",
      "enum": [
        "completed",
        "interrupted"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "sequence"
  ]
}
