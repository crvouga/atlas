{
  "$id": "https://github.com/crvouga/atlas/schemas/ui-catalog-failures-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "`all-history` or `definition`"
        },
        "status": {
          "type": "string",
          "description": "`applied` or `unavailable`; any other value is an unknown scope"
        },
        "definition": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "description": "The SHA-256 of the canonical definition"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "version",
            "name"
          ],
          "additionalProperties": {}
        },
        "expected": {
          "description": "What the definition expects: its states, its profiles and their product",
          "type": "object",
          "properties": {
            "states": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "profiles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "states",
            "profiles",
            "cells"
          ],
          "additionalProperties": {}
        },
        "excluded": {
          "description": "Recorded history outside the definition: not counted in this document, still in the layers",
          "type": "object",
          "properties": {
            "states": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "profiles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cells": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "coverage": {
              "type": "object",
              "properties": {
                "captured": {
                  "type": "number"
                },
                "failed": {
                  "type": "number"
                },
                "capturing": {
                  "type": "number"
                },
                "skipped": {
                  "type": "number"
                },
                "missing": {
                  "type": "number"
                }
              },
              "required": [
                "captured",
                "failed",
                "capturing",
                "skipped",
                "missing"
              ],
              "additionalProperties": {}
            }
          },
          "required": [
            "states",
            "profiles",
            "cells",
            "coverage"
          ],
          "additionalProperties": {}
        },
        "reason": {
          "description": "Why the scope is unavailable",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "status"
      ],
      "additionalProperties": {}
    },
    "total": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Failed cells in the scope and filters"
        },
        "groups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fingerprinted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Failed cells grouped by a producer's fingerprint"
        },
        "inferred": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Failed cells grouped by message only"
        }
      },
      "required": [
        "failed",
        "groups",
        "fingerprinted",
        "inferred"
      ],
      "additionalProperties": {}
    },
    "complete": {
      "type": "boolean",
      "description": "False when a backend or layer could not be read, the definition scope is unavailable, captures are still in progress or only a page was given"
    },
    "incomplete": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "description": "`fingerprint` or `message`"
          },
          "inferred": {
            "type": "boolean",
            "description": "True for a message group: inferred from text, not a shared cause"
          },
          "fingerprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "producers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "states": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "profiles": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempts": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "firstRecordedAtMs": {
            "type": "number"
          },
          "lastRecordedAtMs": {
            "type": "number"
          },
          "sample": {
            "type": "string",
            "description": "The newest failure's message, redacted"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "profile": {
                  "type": "string",
                  "description": "The profile key: with `state`, the cell to link to"
                },
                "profileLabel": {
                  "type": "string"
                },
                "recordedAtMs": {
                  "type": "number"
                },
                "producer": {
                  "type": "string"
                },
                "layer": {
                  "type": "string"
                },
                "backend": {
                  "type": "string"
                },
                "phase": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "attempts": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "state",
                "title",
                "profile",
                "profileLabel",
                "recordedAtMs",
                "producer",
                "layer",
                "backend",
                "phase",
                "attempts"
              ],
              "additionalProperties": {}
            },
            "description": "The affected cells, newest first, at most `maxCells`; `count` is all of them"
          }
        },
        "required": [
          "key",
          "basis",
          "inferred",
          "fingerprint",
          "producers",
          "count",
          "states",
          "profiles",
          "phases",
          "attempts",
          "firstRecordedAtMs",
          "lastRecordedAtMs",
          "sample",
          "cells"
        ],
        "additionalProperties": {}
      }
    },
    "ok": {
      "type": "boolean",
      "description": "True only when no cell failed and the groups are complete (otherwise the exit code is 1)"
    }
  },
  "required": [
    "schemaVersion",
    "total",
    "complete",
    "incomplete",
    "groups",
    "ok"
  ],
  "additionalProperties": {}
}
