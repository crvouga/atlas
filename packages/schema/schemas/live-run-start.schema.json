{
  "$id": "https://github.com/crvouga/atlas/schemas/live-run-start.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "maxLength": 2048
    },
    "environment": {
      "type": "string",
      "maxLength": 200
    },
    "branch": {
      "type": "string",
      "maxLength": 500
    },
    "sha": {
      "type": "string",
      "maxLength": 200
    },
    "plannedChecks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "required": [
    "id",
    "producer"
  ]
}
