{
  "$id": "https://github.com/crvouga/atlas/schemas/report-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "run": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "`run:<id>` for an execution a producer named, else the run URL, else `branch@sha`. Pass it to `/api/reports/runs/detail?key=` or `/api/reports/tests?run=`"
        },
        "runId": {
          "description": "The execution id the producer named, when it did. Layers that share it are one run however many uploads they took",
          "type": "string"
        },
        "title": {
          "description": "The human title of the execution (the newest layer's). Presentation only: the key, commit and `freshness` are unaffected",
          "type": "string"
        },
        "freshness": {
          "description": "`modified` when any layer of the run was recorded from a checkout with uncommitted changes; `unknown` when an origin was not captured; absent when all are clean. Shown beside the commit, never replaced by the title",
          "type": "string",
          "enum": [
            "unknown",
            "modified"
          ]
        },
        "runUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAtMs": {
          "type": "number"
        },
        "endedAtMs": {
          "type": "number"
        },
        "spanMs": {
          "type": "number"
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "counts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required": [
            "passed",
            "failed",
            "running",
            "not-run"
          ]
        },
        "totalDurationMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "failing": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "environment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "title",
              "environment",
              "detail"
            ],
            "additionalProperties": {}
          }
        },
        "videos": {
          "description": "Its videos, from its layers and the last result of each test. Absent when it has none or the report carries no video information",
          "type": "object",
          "properties": {
            "references": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Every reference to a video; identical bytes referenced twice count twice"
            },
            "recordings": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Distinct playable recordings"
            },
            "unavailable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "References that name no bytes"
            }
          },
          "required": [
            "references",
            "recordings",
            "unavailable"
          ],
          "additionalProperties": {}
        },
        "attachments": {
          "description": "Files attached to the run itself, in its layers, not to a check. Absent when there are none",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "artifactTags": {
          "description": "The normalized tags of the attachments of its results, sorted and distinct. Absent when none is tagged, and in reports of older servers",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "description": "The tags of its checks and layers, which its attachments inherit (what `inherited=1` also matches). Absent when none",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "types": {
          "description": "The media types (roles) of its attachments, sorted and distinct; `video` only for a playable recording. Absent when it has no attachment",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "description": "The `key=value` labels of its results and layers, sorted and distinct. Absent when it has none",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "key",
        "runUrl",
        "branch",
        "sha",
        "startedAtMs",
        "endedAtMs",
        "spanMs",
        "producers",
        "environments",
        "layers",
        "tests",
        "counts",
        "totalDurationMs",
        "failing"
      ],
      "additionalProperties": {}
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "specPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "producer": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          },
          "durationMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "at": {
            "type": "number"
          },
          "layer": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "videos": {
            "description": "Every video its evidence references, with who holds it",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The attachment name"
                },
                "owner": {
                  "type": "string",
                  "description": "Who holds it: `layer`, `check`, `attempt` or `step`. An open vocabulary: treat an unknown owner as a check"
                },
                "attempt": {
                  "description": "The retry attempt that holds it, or that holds the step that does",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "step": {
                  "description": "The name of the step that holds it",
                  "type": "string"
                },
                "tags": {
                  "description": "The normalized tags of this attachment itself. Absent when it has none (and in documents of older servers)",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "recording": {
                  "description": "What identifies the bytes; references with the same value are one recording. Absent when it cannot be played",
                  "type": "string"
                },
                "available": {
                  "type": "boolean",
                  "description": "False when the reference names no bytes (no bundle key, address or inline text)"
                },
                "scope": {
                  "description": "What this recording shows as its producer declared it: its own `scope`, else its attempt's, check's, part's or layer's. Absent: the scope is unknown, never live, physical or audible",
                  "type": "object",
                  "properties": {
                    "surface": {
                      "description": "Where the product ran, in an open vocabulary: `browser`, `native-app`, `api`, `cli`…",
                      "type": "string",
                      "minLength": 1
                    },
                    "deviceKind": {
                      "description": "What it ran on, in an open vocabulary: `simulator`, `emulator`, `physical`, `virtual-machine`, `desktop`… A simulator and a physical phone stay distinct values; they are filtered separately",
                      "type": "string",
                      "minLength": 1
                    },
                    "syntheticData": {
                      "description": "True: the data was made up for the run. False: real data. Absent: unknown",
                      "type": "boolean"
                    },
                    "dependencies": {
                      "description": "Whether what the product talks to was `scripted` (replies fixed in advance), `live` or `mixed`. An open vocabulary; absent is unknown",
                      "type": "string",
                      "minLength": 1
                    },
                    "audioCaptured": {
                      "description": "True: the recording has real audio. False: it is silent. Absent: unknown",
                      "type": "boolean"
                    },
                    "pacing": {
                      "description": "How time ran, in an open vocabulary: `paced` (slowed or scripted for a viewer), `real-time`. Absent: unknown",
                      "type": "string",
                      "minLength": 1
                    },
                    "asserted": {
                      "description": "The boundaries the result actually asserts. Activity visible in a recording beyond them is not verified behavior",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "limitations": {
                      "description": "Known limits of what this evidence shows, in the producer's words",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "declaredBy": {
                      "description": "Who or what made this declaration: a tool, a team, a person",
                      "type": "string"
                    },
                    "verified": {
                      "description": "The names of the fields above (`surface`, `deviceKind`, `syntheticData`, `dependencies`, `audioCaptured`, `pacing`) that something independent of the producer checked. Every other field is only declared",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "verifiedBy": {
                      "description": "What checked the `verified` fields",
                      "type": "string"
                    },
                    "provenance": {
                      "description": "Where the declaration comes from and how to check it: a document, a CI step, a device log",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "minLength": 1
                          },
                          "name": {
                            "type": "string"
                          },
                          "rel": {
                            "description": "Why it is linked, in an open vocabulary: issue, run, trace, docs, source…",
                            "type": "string"
                          }
                        },
                        "required": [
                          "url"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "extensions": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1
                      },
                      "additionalProperties": {}
                    }
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "name",
                "owner",
                "available"
              ],
              "additionalProperties": {}
            }
          },
          "kind": {
            "description": "The kind of the part that held it. With the producer, environment and parameters it is the condition the result was recorded under. Absent from an older server",
            "type": "string"
          },
          "parameters": {
            "description": "The other choices that made it its own result (a device size, a locale…). Absent when there are none, and from an older server",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "specRevision": {
            "description": "The fingerprint of its spec file the layer recorded. Absent means not recorded, never \"the same\"",
            "type": "string"
          },
          "recordedTitle": {
            "description": "The title this run's layer gave the check. `title` is the check's newest title in the whole history; this is the wording as recorded. Absent from an older server",
            "type": "string"
          }
        },
        "required": [
          "key",
          "id",
          "title",
          "specPath",
          "environment",
          "producer",
          "status",
          "durationMs",
          "at",
          "layer",
          "detail"
        ],
        "additionalProperties": {}
      }
    },
    "layers": {
      "description": "Every layer of the run, oldest first. Absent from an older server",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The layer id; read its files with `/api/reports/evidence/detail/{backend}/{id}`"
          },
          "backend": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "recordedAtMs": {
            "type": "number"
          },
          "checks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "How many checks the layer recorded. Zero means evidence only, not a pass"
          },
          "attachments": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Files the layer carries as a whole, not those of its checks"
          },
          "videos": {
            "type": "object",
            "properties": {
              "references": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Every reference to a video; identical bytes referenced twice count twice"
              },
              "recordings": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Distinct playable recordings"
              },
              "unavailable": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "References that name no bytes"
              }
            },
            "required": [
              "references",
              "recordings",
              "unavailable"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "backend",
          "producer",
          "environment",
          "recordedAtMs",
          "checks",
          "attachments"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "run",
    "results"
  ],
  "additionalProperties": {}
}
