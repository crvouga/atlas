{
  "$id": "https://github.com/crvouga/atlas/schemas/spec-set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the branch, commit, freshness and the digest of every file: the same specs from the same commit are the same set"
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "recordedAtMs": {
      "type": "number",
      "minimum": 0,
      "description": "For a clean checkout, the commit time; for a modified one, when it was published"
    },
    "freshness": {
      "type": "string",
      "enum": [
        "unknown",
        "modified"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "`specs/<path inside the specs directory>`, the name a check uses in `specPath`"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the file. Its text is at layers/specs/blobs/<digest>.txt"
          },
          "fingerprint": {
            "type": "string",
            "description": "The advisory fingerprint layers record, to warn when a spec changed since they ran"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "digest",
          "fingerprint",
          "kind",
          "title",
          "domain",
          "bytes"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "branch",
    "sha",
    "recordedAtMs",
    "files"
  ],
  "additionalProperties": {}
}
