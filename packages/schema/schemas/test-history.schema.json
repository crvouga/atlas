{
  "$id": "https://github.com/crvouga/atlas/schemas/test-history.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "test": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "The test's identity, `JSON.stringify([specPath, id])`. Pass it to `/api/reports/tests/history?key=`"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "specPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "spec": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "title",
                "domain",
                "kind"
              ],
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ],
          "description": "The spec it belongs to: recorded by its layers, published in a spec set, or derived from the path"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "running",
            "not-run"
          ],
          "description": "The worst current result across environments: failed, then running, then not-run, then passed"
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "number",
                "description": "When it was recorded, epoch milliseconds"
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "running",
                  "not-run"
                ]
              },
              "durationMs": {
                "description": "How long it took, or null when the producer did not measure it",
                "type": [
                  "number",
                  "null"
                ]
              },
              "environment": {
                "description": "The client it checked, such as `desktop-web` or `ios`",
                "type": [
                  "string",
                  "null"
                ]
              },
              "producer": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "runUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "run": {
                "type": "string",
                "description": "The key of the run it belongs to, as `GET /api/reports/runs` lists it"
              },
              "layer": {
                "type": "string",
                "description": "The id of the layer that recorded it"
              },
              "backend": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "description": "Why it has its status, at most 500 characters"
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "attachments": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "steps": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "annotations": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "attempts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "links": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "artifactTags": {
                    "description": "Normalized tags of the attachments themselves, sorted and distinct. Absent when no attachment is tagged; never inherited from a check or run",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "labels": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "attachments",
                  "steps",
                  "annotations",
                  "attempts",
                  "links",
                  "tags",
                  "labels",
                  "roles"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "at",
              "status",
              "durationMs",
              "environment",
              "producer",
              "kind",
              "parameters",
              "branch",
              "sha",
              "runUrl",
              "run",
              "layer",
              "backend",
              "detail"
            ],
            "additionalProperties": {}
          },
          "description": "The current result per producer, environment and parameter set, newest first"
        },
        "stats": {
          "type": "object",
          "properties": {
            "results": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passRate": {
              "description": "passed / (passed + failed), or null with no completed result",
              "type": [
                "number",
                "null"
              ]
            },
            "flaky": {
              "type": "boolean"
            },
            "flakyReason": {
              "type": "string"
            },
            "flips": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "durations": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "totalMs": {
                      "type": "number"
                    },
                    "avgMs": {
                      "type": "number"
                    },
                    "p50Ms": {
                      "type": "number"
                    },
                    "p95Ms": {
                      "type": "number"
                    },
                    "minMs": {
                      "type": "number"
                    },
                    "maxMs": {
                      "type": "number"
                    },
                    "lastMs": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "count",
                    "totalMs",
                    "avgMs",
                    "p50Ms",
                    "p95Ms",
                    "minMs",
                    "maxMs",
                    "lastMs"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ]
            },
            "firstSeenMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "lastSeenMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "lastPassedAtMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "lastFailedAtMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "branches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "results",
            "passed",
            "failed",
            "passRate",
            "flaky",
            "flakyReason",
            "flips",
            "durations",
            "firstSeenMs",
            "lastSeenMs",
            "lastPassedAtMs",
            "lastFailedAtMs",
            "runs",
            "branches"
          ],
          "additionalProperties": {}
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifactTags": {
          "description": "Normalized tags of the attachments of its current results, such as `demo` (shown `#demo`). Not inherited from a check or run, unlike `tags`",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inheritedArtifactTags": {
          "description": "Normalized tags its attachments inherit from their check and run, apart from `artifactTags`: what `?artifactTag=…&inherited=1` also matches",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "object",
          "properties": {
            "attachments": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "attachments",
            "steps",
            "attempts",
            "roles"
          ],
          "additionalProperties": {}
        },
        "lastRecordedAtMs": {
          "type": "number"
        },
        "live": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "id",
        "title",
        "specPath",
        "spec",
        "status",
        "environments",
        "producers",
        "outcomes",
        "stats",
        "tags",
        "labels",
        "evidence",
        "lastRecordedAtMs",
        "live"
      ],
      "additionalProperties": {}
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "description": "When it was recorded, epoch milliseconds"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          },
          "durationMs": {
            "description": "How long it took, or null when the producer did not measure it",
            "type": [
              "number",
              "null"
            ]
          },
          "environment": {
            "description": "The client it checked, such as `desktop-web` or `ios`",
            "type": [
              "string",
              "null"
            ]
          },
          "producer": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "runUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "run": {
            "type": "string",
            "description": "The key of the run it belongs to, as `GET /api/reports/runs` lists it"
          },
          "layer": {
            "type": "string",
            "description": "The id of the layer that recorded it"
          },
          "backend": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "description": "Why it has its status, at most 500 characters"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "attachments": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "steps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "annotations": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "links": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "artifactTags": {
                "description": "Normalized tags of the attachments themselves, sorted and distinct. Absent when no attachment is tagged; never inherited from a check or run",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "labels": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "attachments",
              "steps",
              "annotations",
              "attempts",
              "links",
              "tags",
              "labels",
              "roles"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "at",
          "status",
          "durationMs",
          "environment",
          "producer",
          "kind",
          "parameters",
          "branch",
          "sha",
          "runUrl",
          "run",
          "layer",
          "backend",
          "detail"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "test",
    "history"
  ],
  "additionalProperties": {}
}
