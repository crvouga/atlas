{
  "$id": "https://github.com/crvouga/atlas/schemas/test-history.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "test": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "The test's identity, `JSON.stringify([specPath, id])`. Pass it to `/api/reports/tests/history?key=`"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "specPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "spec": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "title",
                "domain",
                "kind"
              ],
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ],
          "description": "The spec it belongs to: recorded by its layers, published in a spec set, or derived from the path"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "running",
            "not-run"
          ],
          "description": "The worst current result across environments: failed, then running, then not-run, then passed"
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "number",
                "description": "When it was recorded, epoch milliseconds"
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "running",
                  "not-run"
                ]
              },
              "durationMs": {
                "description": "How long it took, or null when the producer did not measure it",
                "type": [
                  "number",
                  "null"
                ]
              },
              "environment": {
                "description": "The client it checked, such as `desktop-web` or `ios`",
                "type": [
                  "string",
                  "null"
                ]
              },
              "producer": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "runUrl": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "run": {
                "type": "string",
                "description": "The key of the run it belongs to, as `GET /api/reports/runs` lists it"
              },
              "layer": {
                "type": "string",
                "description": "The id of the layer that recorded it"
              },
              "backend": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "description": "Why it has its status, at most 500 characters"
              },
              "specRevision": {
                "description": "The fingerprint of its spec text that the layer recorded, when it recorded one. Two results with different revisions were recorded against different promises. Absent: not recorded, never assumed to match",
                "type": "string"
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "attachments": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "steps": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "annotations": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "attempts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "attemptStatuses": {
                    "description": "The status of each recorded try, in the order they were made. Absent when no try was recorded, and in reports written before this was recorded: a first try is then unknown, never assumed to have passed",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "passed",
                        "failed",
                        "running",
                        "not-run"
                      ]
                    }
                  },
                  "links": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "artifactTags": {
                    "description": "Normalized tags of the attachments themselves, sorted and distinct. Absent when no attachment is tagged; never inherited from a check or run",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "labels": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "videos": {
                    "description": "Its references to videos and who holds each. Absent when it has none, and in reports written before this was recorded",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "The attachment name"
                        },
                        "owner": {
                          "type": "string",
                          "description": "Who holds it: `layer`, `check`, `attempt` or `step`. An open vocabulary: treat an unknown owner as a check"
                        },
                        "attempt": {
                          "description": "The retry attempt that holds it, or that holds the step that does",
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "step": {
                          "description": "The name of the step that holds it",
                          "type": "string"
                        },
                        "tags": {
                          "description": "The normalized tags of this attachment itself. Absent when it has none (and in documents of older servers)",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "recording": {
                          "description": "What identifies the bytes; references with the same value are one recording. Absent when it cannot be played",
                          "type": "string"
                        },
                        "available": {
                          "type": "boolean",
                          "description": "False when the reference names no bytes (no bundle key, address or inline text)"
                        },
                        "scope": {
                          "description": "What this recording shows as its producer declared it: its own `scope`, else its attempt's, check's, part's or layer's. Absent: the scope is unknown, never live, physical or audible",
                          "type": "object",
                          "properties": {
                            "surface": {
                              "description": "Where the product ran, in an open vocabulary: `browser`, `native-app`, `api`, `cli`…",
                              "type": "string",
                              "minLength": 1
                            },
                            "deviceKind": {
                              "description": "What it ran on, in an open vocabulary: `simulator`, `emulator`, `physical`, `virtual-machine`, `desktop`… A simulator and a physical phone stay distinct values; they are filtered separately",
                              "type": "string",
                              "minLength": 1
                            },
                            "syntheticData": {
                              "description": "True: the data was made up for the run. False: real data. Absent: unknown",
                              "type": "boolean"
                            },
                            "dependencies": {
                              "description": "Whether what the product talks to was `scripted` (replies fixed in advance), `live` or `mixed`. An open vocabulary; absent is unknown",
                              "type": "string",
                              "minLength": 1
                            },
                            "audioCaptured": {
                              "description": "True: the recording has real audio. False: it is silent. Absent: unknown",
                              "type": "boolean"
                            },
                            "pacing": {
                              "description": "How time ran, in an open vocabulary: `paced` (slowed or scripted for a viewer), `real-time`. Absent: unknown",
                              "type": "string",
                              "minLength": 1
                            },
                            "asserted": {
                              "description": "The boundaries the result actually asserts. Activity visible in a recording beyond them is not verified behavior",
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "limitations": {
                              "description": "Known limits of what this evidence shows, in the producer's words",
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "declaredBy": {
                              "description": "Who or what made this declaration: a tool, a team, a person",
                              "type": "string"
                            },
                            "verified": {
                              "description": "The names of the fields above (`surface`, `deviceKind`, `syntheticData`, `dependencies`, `audioCaptured`, `pacing`) that something independent of the producer checked. Every other field is only declared",
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "verifiedBy": {
                              "description": "What checked the `verified` fields",
                              "type": "string"
                            },
                            "provenance": {
                              "description": "Where the declaration comes from and how to check it: a document, a CI step, a device log",
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "url": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "rel": {
                                    "description": "Why it is linked, in an open vocabulary: issue, run, trace, docs, source…",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "url"
                                ],
                                "additionalProperties": {}
                              }
                            },
                            "extensions": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string",
                                "minLength": 1
                              },
                              "additionalProperties": {}
                            }
                          },
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "name",
                        "owner",
                        "available"
                      ],
                      "additionalProperties": {}
                    }
                  }
                },
                "required": [
                  "attachments",
                  "steps",
                  "annotations",
                  "attempts",
                  "links",
                  "tags",
                  "labels",
                  "roles"
                ],
                "additionalProperties": {}
              },
              "latency": {
                "description": "Its product-latency measurements (`kind: product-latency`), when it recorded any. Separate from `durationMs`, which is how long the test took",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "number",
                      "description": "A finite number"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "limit": {
                      "description": "The allowance, or budget. A measurement over it is reported, and never fails the check by itself",
                      "type": "number"
                    },
                    "kind": {
                      "description": "What the number is, in an open vocabulary. `product-latency`: a user-visible response time between `from` and `to`. Absent: just a number, never read as product latency",
                      "type": "string",
                      "minLength": 1
                    },
                    "from": {
                      "description": "The event the interval starts at. Without both `from` and `to` a latency is shown but no product claim is made from it",
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "description": "The event the interval ends at",
                      "type": "string",
                      "minLength": 1
                    },
                    "intended": {
                      "description": "The interval the name of the measurement claims, when what was measured is only part of it. If `intended.to` differs from `to` (or `intended.from` from `from`) the measurement is shown as partial, never as the complete interval",
                      "type": "object",
                      "properties": {
                        "from": {
                          "description": "The event the interval starts at: `end of speech`, `submit pressed`",
                          "type": "string",
                          "minLength": 1
                        },
                        "to": {
                          "description": "The event the interval ends at: `audible response`, `confirmation visible`",
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": {}
                    },
                    "source": {
                      "description": "How it was measured: `app-instrumentation`, `trace`, `recording-analysis`",
                      "type": "string"
                    },
                    "outcome": {
                      "description": "`observed` (the default), `timeout` or `failed`. For anything but `observed` the value is how long the observation waited: at least that much, so it counts against a budget and is never dropped",
                      "type": "string",
                      "minLength": 1
                    },
                    "instrumentation": {
                      "description": "The version or method of the measurement. A change of it between two sets of observations is disclosed when they are compared",
                      "type": "string"
                    },
                    "labels": {
                      "description": "What the observation is comparable with: `device`, `build`, `network`. `device` and `build` group the observations and, when two groups differ in the others, the comparison says so",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "value",
                    "unit"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "at",
              "status",
              "durationMs",
              "environment",
              "producer",
              "kind",
              "parameters",
              "branch",
              "sha",
              "runUrl",
              "run",
              "layer",
              "backend",
              "detail"
            ],
            "additionalProperties": {}
          },
          "description": "The current result per producer, environment and parameter set, newest first"
        },
        "stats": {
          "type": "object",
          "properties": {
            "results": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passRate": {
              "description": "passed / (passed + failed), or null with no completed result",
              "type": [
                "number",
                "null"
              ]
            },
            "flaky": {
              "type": "boolean"
            },
            "flakyReason": {
              "type": "string"
            },
            "flips": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "durations": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "totalMs": {
                      "type": "number"
                    },
                    "avgMs": {
                      "type": "number"
                    },
                    "p50Ms": {
                      "type": "number"
                    },
                    "p95Ms": {
                      "type": "number"
                    },
                    "minMs": {
                      "type": "number"
                    },
                    "maxMs": {
                      "type": "number"
                    },
                    "lastMs": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "count",
                    "totalMs",
                    "avgMs",
                    "p50Ms",
                    "p95Ms",
                    "minMs",
                    "maxMs",
                    "lastMs"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ]
            },
            "firstSeenMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "lastSeenMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "lastPassedAtMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "lastFailedAtMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "branches": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "results",
            "passed",
            "failed",
            "passRate",
            "flaky",
            "flakyReason",
            "flips",
            "durations",
            "firstSeenMs",
            "lastSeenMs",
            "lastPassedAtMs",
            "lastFailedAtMs",
            "runs",
            "branches"
          ],
          "additionalProperties": {}
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifactTags": {
          "description": "Normalized tags of the attachments of its current results, such as `demo` (shown `#demo`). Not inherited from a check or run, unlike `tags`",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inheritedArtifactTags": {
          "description": "Normalized tags its attachments inherit from their check and run, apart from `artifactTags`: what `?artifactTag=…&inherited=1` also matches",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopeProfiles": {
          "description": "The scope tokens each distinct playable recording of its current results declares (`device:physical`, `audio:silent`); `[\"unknown\"]` for a recording that declared none. What `?scope=` matches, one recording at a time. Absent when it has no playable recording",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "object",
          "properties": {
            "attachments": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "attachments",
            "steps",
            "attempts",
            "roles"
          ],
          "additionalProperties": {}
        },
        "lastRecordedAtMs": {
          "type": "number"
        },
        "live": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "id",
        "title",
        "specPath",
        "spec",
        "status",
        "environments",
        "producers",
        "outcomes",
        "stats",
        "tags",
        "labels",
        "evidence",
        "lastRecordedAtMs",
        "live"
      ],
      "additionalProperties": {}
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "number",
            "description": "When it was recorded, epoch milliseconds"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "running",
              "not-run"
            ]
          },
          "durationMs": {
            "description": "How long it took, or null when the producer did not measure it",
            "type": [
              "number",
              "null"
            ]
          },
          "environment": {
            "description": "The client it checked, such as `desktop-web` or `ios`",
            "type": [
              "string",
              "null"
            ]
          },
          "producer": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "runUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "run": {
            "type": "string",
            "description": "The key of the run it belongs to, as `GET /api/reports/runs` lists it"
          },
          "layer": {
            "type": "string",
            "description": "The id of the layer that recorded it"
          },
          "backend": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "description": "Why it has its status, at most 500 characters"
          },
          "specRevision": {
            "description": "The fingerprint of its spec text that the layer recorded, when it recorded one. Two results with different revisions were recorded against different promises. Absent: not recorded, never assumed to match",
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "attachments": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "steps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "annotations": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "attemptStatuses": {
                "description": "The status of each recorded try, in the order they were made. Absent when no try was recorded, and in reports written before this was recorded: a first try is then unknown, never assumed to have passed",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed",
                    "running",
                    "not-run"
                  ]
                }
              },
              "links": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "artifactTags": {
                "description": "Normalized tags of the attachments themselves, sorted and distinct. Absent when no attachment is tagged; never inherited from a check or run",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "labels": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "videos": {
                "description": "Its references to videos and who holds each. Absent when it has none, and in reports written before this was recorded",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The attachment name"
                    },
                    "owner": {
                      "type": "string",
                      "description": "Who holds it: `layer`, `check`, `attempt` or `step`. An open vocabulary: treat an unknown owner as a check"
                    },
                    "attempt": {
                      "description": "The retry attempt that holds it, or that holds the step that does",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "step": {
                      "description": "The name of the step that holds it",
                      "type": "string"
                    },
                    "tags": {
                      "description": "The normalized tags of this attachment itself. Absent when it has none (and in documents of older servers)",
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "recording": {
                      "description": "What identifies the bytes; references with the same value are one recording. Absent when it cannot be played",
                      "type": "string"
                    },
                    "available": {
                      "type": "boolean",
                      "description": "False when the reference names no bytes (no bundle key, address or inline text)"
                    },
                    "scope": {
