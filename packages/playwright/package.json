{
  "name": "@crvouga/atlas-playwright",
  "version": "0.1.0",
  "description": "Playwright driver for Atlas: run statecharts against a web app with paced, touch-annotated videos at device resolution and signal-based state recognisers.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/crvouga/atlas", "directory": "packages/playwright" },
  "exports": { ".": "./src/index.ts" },
  "publishConfig": { "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } } },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@crvouga/atlas": "workspace:*"
  },
  "peerDependencies": {
    "playwright": ">=1.45"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "playwright": "1.60.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
