# Atlas server environment. Copy to `.env` (Bun loads it) or set these in your host, container or secret manager.
#
# Workspace Run starts persistent local Mockingbird S3 automatically if no ATLAS_S3_* settings are supplied.
# Only copy this file when choosing external S3; a partial configuration is an error.
#
# WHY THESE ARE REQUIRED FOR THE STANDALONE SERVER OR EXTERNAL S3
#   The Atlas server keeps ALL reports and ALL user state in S3-compatible object storage, and nowhere else.
#   User state is one JSON document in the bucket (`server/state.json`) holding the garbage collection policy,
#   which you define in the Atlas UI at /admin, and the settings saved there. There is no local-disk, in-memory or
#   database fallback, so the server REFUSES TO START (exit status 2) unless all five required variables are set
#   and valid and the bucket accepts them. It prints every variable below with what is missing or wrong.
#
# Works with AWS S3, Cloudflare R2, MinIO, SeaweedFS, Backblaze B2 and anything that speaks the S3 protocol.

# ---- Required ---------------------------------------------------------------------------------------------------
# S3 API endpoint of the object storage service.
ATLAS_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# Bucket for reports and user state. It must already exist.
ATLAS_S3_BUCKET=my-atlas-reports
# Region of the bucket. Use `auto` for Cloudflare R2, `us-east-1` for most self-hosted servers.
ATLAS_S3_REGION=eu-west-1
# Credentials of an account that may list, read, write and delete objects in the bucket (and prefix).
ATLAS_S3_ACCESS_KEY_ID=
ATLAS_S3_SECRET_ACCESS_KEY=

# ---- Optional ---------------------------------------------------------------------------------------------------
# A folder inside the bucket for everything Atlas writes. Default: the bucket root.
# ATLAS_S3_PREFIX=atlas
# Address the bucket as endpoint/bucket/key (1, the default) or as bucket.endpoint/key (0).
# ATLAS_S3_PATH_STYLE=1
# Only for temporary credentials.
# ATLAS_S3_SESSION_TOKEN=

# ---- Access control (see docs/server.md) -------------------------------------------------------------------------
# Needed to listen beyond this machine. Use long random values: openssl rand -hex 24
# ATLAS_TOKEN=            # admin: may also edit the garbage collection policy and settings
# ATLAS_PUBLISH_TOKEN=    # may upload results
# ATLAS_READ_TOKEN=       # may look
